@using UtilityPaymentJournal.Models.ViewModels
@model CreateUserViewModel
@{
    ViewData["Title"] = "Account";
}

<div>
    <form id="creationForm" class="p-4 border rounded shadow-sm bg-white" style="max-width: 400px; margin: auto;">
        <h3 class="text-center mb-4">Создание пользователя</h3>

        @Html.AntiForgeryToken()

        <div id="validationSummary" class="text-danger mb-3"></div>

        <div class="form-floating mb-3">
            <input asp-for="UserName" class="form-control" id="username" placeholder="Логин" />
            <label asp-for="UserName"></label>
            <span asp-validation-for="UserName" class="text-danger"></span>
        </div>

        <div class="form-floating mb-3">
            <input asp-for="FirstName" class="form-control" id="firstname" placeholder="Имя" />
            <label asp-for="FirstName"></label>
            <span asp-validation-for="FirstName" class="text-danger"></span>
        </div>

        <div class="form-floating mb-3">
            <input asp-for="LastName" class="form-control" id="lastname" placeholder="Фамилия" />
            <label asp-for="LastName"></label>
            <span asp-validation-for="LastName" class="text-danger"></span>
        </div>

        <div class="form-floating mb-3">
            <input asp-for="Password" type="password" class="form-control" id="password" placeholder="Пароль" />
            <label asp-for="Password"></label>
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <button type="submit" class="w-100 btn btn-primary">Создать</button>
    </form>
</div>

<partial name="_AlertModal" />

@section Scripts {
    <script>
    $('#creationForm').on('submit', function (e) {
        e.preventDefault();

        const $summary = $('#validationSummary');
        $summary.empty();

        const token = $('input[name="__RequestVerificationToken"]').val();

        const userData = {
            userName: $('#username').val(),
            firstName: $('#firstname').val(),
            lastName: $('#lastname').val(),
            password: $('#password').val(),
            role: 0 // создаем пользовательские роли User
        };

        $.ajax({
            url: '/api/admin/users',
            type: 'POST',
            contentType: 'application/json; charset=utf-8',
            dataType: 'json',
            data: JSON.stringify(userData),
            headers: {
                'X-Requested-With': 'XMLHttpRequest',
                'RequestVerificationToken': token
            },
            success: function () {
                    $summary.removeClass('text-danger').addClass('text-success');

                    showAlert("Пользователь успешно создан!");

                    const form = document.getElementById('creationForm');
                    form.reset();
                    $(form).find('.is-valid, .is-invalid').removeClass('is-valid is-invalid');
            },
            error: function (xhr) {
                $summary.removeClass('text-success').addClass('text-danger');

                if (xhr.responseJSON && xhr.responseJSON.errorMessage) {
                    showAlert(xhr.responseJSON.errorMessage);
                    return;
                }

                if (typeof tryShowServerError === 'function' && tryShowServerError(xhr)) {
                    return;
                }

                showAlert('Произошла непредвиденная ошибка на сервере.');
            }
        });
    });
</script>
}
