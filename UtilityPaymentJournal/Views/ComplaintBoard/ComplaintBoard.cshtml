@model UtilityPaymentJournal.Models.ComplaintBoard.ComplaintBoardViewModel
@using UtilityPaymentJournal.Enumerations
@using UtilityPaymentJournal.Models.ComplaintBoard


@{
    ViewData["Title"] = "Интерактивный журнал жалоб";
}

@{
    object RenderComplaintCard(ComplaintViewModel card)
    {
        // Берем иконку услуги
        string iconClass = card.UtilityIcon ?? "bi-tools";

        <div class="mb-3 handle-card notebook-complaint-card p-3 shadow-sm bg-white rounded"
             id="complaint-@card.Id"
             draggable="true"
             ondragstart="drag(event)"
             data-id="@card.Id"
             data-status="@((int)card.Status)">

            <!-- ЗОНА 1: ХЭДЕР (Иконка + Title + Кнопки управления) -->
            <div class="d-flex justify-content-between align-items-start gap-2">
                <div class="d-flex align-items-start gap-2 flex-grow-1">
                    <!-- Иконка услуги: сброшено текстовое выравнивание, прижата строго к верхнему краю -->
                    <i class="bi @iconClass fs-5 js-card-icon align-self-start" style="display: block; line-height: 1; height: fit-content; margin: 0; padding: 0;" title="@card.UtilityName"></i>

                    <!-- Заголовок карточки: сброшены лишние отступы, line-height: 1 делает верхний край текста чистым -->
                    <h6 class="mb-0 notebook-card-title js-card-title font-weight-bold align-self-start" style="line-height: 1; margin: 0; padding: 0;">@card.Title</h6>
                </div>

                <!-- Кнопки управления: убран внутренний padding кнопок Bootstrap, который смещал их вниз -->
                <div class="d-flex align-items-start gap-1 btn-group-sm align-self-start" style="height: fit-content;">
                    <button class="btn btn-link p-0 m-0 notebook-card-action-btn btn-edit btn-edit-complaint border-0 text-decoration-none text-muted align-self-start"
                            data-id="@card.Id"
                            data-utility-id="@card.UtilityId"
                            data-bs-toggle="modal"
                            data-bs-target="#editModal"
                            title="Редактировать"
                            style="display: block; line-height: 1; height: fit-content;">
                        <i class="bi bi-pencil" style="display: block; line-height: 1;"></i>
                    </button>
                    <button class="btn btn-link p-0 m-0 notebook-card-action-btn btn-delete btn-delete-complaint border-0 text-decoration-none text-muted align-self-start"
                            data-id="@card.Id"
                            data-utility-name="@card.UtilityName"
                            title="Удалить"
                            style="display: block; line-height: 1; height: fit-content;">
                        <i class="bi bi-trash3" style="display: block; line-height: 1;"></i>
                    </button>
                </div>
            </div>

            <!-- ГОРЗОНТАЛЬНАЯ ЧЕРТА №1 -->
            <hr class="my-2 text-muted opacity-25" />

            <!-- ЗОНА 2: ЦЕНТРАЛЬНАЯ ЧАСТЬ (Description) -->
            <div class="py-1">
                <p class="notebook-card-text mb-0 js-card-description text-secondary small" style="white-space: pre-line;">@card.Description</p>
            </div>

            <!-- ГОРЗОНТАЛЬНАЯ ЧЕРТА №2 -->
            <hr class="my-2 text-muted opacity-25" />

            <!-- ЗОНА 3: ФУТЕР (Даты) -->
            <div class="d-flex flex-column gap-1 text-muted card-footer-date" style="font-size: 0.75rem;">
                <!-- Дата создания -->
                <div class="d-flex justify-content-start align-items-center">
                    <i class="bi bi-file-earmark-plus me-1 text-secondary"></i>
                    <span>Создано: @card.CreatedAt.ToString("dd.MM.yyyy HH:mm")</span>
                </div>

                <!-- Дата подачи (выводится, только если заполнена) -->
                @if (card.SubmissionDate.HasValue)
                {
                    <div class="d-flex justify-content-start align-items-center">
                        <i class="bi bi-send me-1 text-primary"></i>
                        <span>Подано: @card.SubmissionDate.Value.ToString("dd.MM.yyyy HH:mm")</span>
                    </div>
                }

                <!-- Дата решения проблемы (выводится, только если заполнена) -->
                @if (card.IssueResolutionDate.HasValue)
                {
                    <div class="d-flex justify-content-start align-items-center">
                        <i class="bi bi-check-lg me-1 text-success"></i>
                        <span>Решено: @card.IssueResolutionDate.Value.ToString("dd.MM.yyyy HH:mm")</span>
                    </div>
                }
            </div>

        </div>
        return null!;
    }
}

<div class="container-fluid py-4 kanban-board-bg">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="notebook-kanban-title mb-0"></h2>
        <button class="notebook-kanban-add-btn" data-bs-toggle="modal" data-bs-target="#addModal">
            <i class="bi bi-plus-lg me-1"></i> Добавить жалобу
        </button>
    </div>

    <!-- Сетка колонок интерактивной доски -->
    <div class="row">
        <!-- КОЛОНКА: НОВЫЕ -->
        <div class="col-md-4 mb-4">
            <div class="card h-100 notebook-column-card">
                <div class="card-header notebook-column-header header-status-new d-flex justify-content-between align-items-center">
                    <h5 class="m-0">Новые</h5>
                    <span class="badge rounded-pill notebook-column-badge">@(Model?.NewComplaints?.Count ?? 0)</span>
                </div>
                <div class="card-body notebook-column-body complaint-column" style="min-height: 550px;" data-status="@((int)ComplaintStatus.New)" ondragover="allowDrop(event)" ondrop="drop(event)">
                    @if (Model?.NewComplaints != null)
                    {
                        @foreach (var card in Model.NewComplaints)
                        {
                            @RenderComplaintCard(card)
                        }
                    }
                </div>
            </div>
        </div>

        <!-- КОЛОНКА: В РАБОТЕ -->
        <div class="col-md-4 mb-4">
            <div class="card h-100 notebook-column-card">
                <div class="card-header notebook-column-header header-status-progress d-flex justify-content-between align-items-center">
                    <h5 class="m-0">В работе</h5>
                    <span class="badge rounded-pill notebook-column-badge">@(Model?.InProgressComplaints?.Count ?? 0)</span>
                </div>
                <div class="card-body notebook-column-body complaint-column" style="min-height: 550px;" data-status="@((int)ComplaintStatus.InProgress)" ondragover="allowDrop(event)" ondrop="drop(event)">
                    @if (Model?.InProgressComplaints != null)
                    {
                        @foreach (var card in Model.InProgressComplaints)
                        {
                            @RenderComplaintCard(card)
                        }
                    }
                </div>
            </div>
        </div>

        <!-- КОЛОНКА: РЕШЕННЫЕ -->
        <div class="col-md-4 mb-4">
            <div class="card h-100 notebook-column-card">
                <div class="card-header notebook-column-header header-status-resolved d-flex justify-content-between align-items-center">
                    <h5 class="m-0">Решенные</h5>
                    <span class="badge rounded-pill notebook-column-badge">@(Model?.ResolvedComplaints?.Count ?? 0)</span>
                </div>
                <div class="card-body notebook-column-body complaint-column" style="min-height: 550px;" data-status="@((int)ComplaintStatus.Resolved)" ondragover="allowDrop(event)" ondrop="drop(event)">
                    @if (Model?.ResolvedComplaints != null)
                    {
                        @foreach (var card in Model.ResolvedComplaints)
                        {
                            @RenderComplaintCard(card)
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Модальное окно СОЗДАНИЯ записи -->
<div class="modal fade" id="addModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content notebook-modal-content">
            <form id="addComplaintForm">
                <div class="modal-header notebook-modal-header">
                    <h5 class="modal-title font-weight-bold">Новая жалоба</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label text-dark small font-weight-bold">Заголовок</label>
                        <input name="EmptyForm.Title" class="form-control notebook-form-input" placeholder="Кратко назовите проблему" required />
                    </div>

                    <!-- Выбор услуги из общего справочника -->
                    <div class="mb-3">
                        <label class="form-label text-dark small font-weight-bold">Наименование услуги</label>
                        <select name="EmptyForm.UtilityId" class="form-select notebook-form-input" required>
                            <option value="">-- Выберите услугу --</option>
                            @if (Model?.AvailableUtilities != null)
                            {
                                foreach (var utility in Model.AvailableUtilities)
                                {
                                    <option value="@utility.Id">@utility.Name</option>
                                }
                            }
                        </select>
                    </div>

                    <!-- Поля выбора дат -->
                    <div class="row">
                        <div class="col-6 mb-3">
                            <label class="form-label text-dark small font-weight-bold">Дата подачи</label>
                            <input type="datetime-local" name="EmptyForm.SubmissionDate" class="form-control notebook-form-input" />
                        </div>
                        <div class="col-6 mb-3">
                            <label class="form-label text-dark small font-weight-bold">Дата решения</label>
                            <input type="datetime-local" name="EmptyForm.IssueResolutionDate" class="form-control notebook-form-input" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-dark small font-weight-bold">Описание</label>
                        <textarea name="EmptyForm.Description" class="form-control notebook-form-input" rows="4" placeholder="Введите детали..." required></textarea>
                    </div>
                </div>
                <div class="modal-footer notebook-modal-footer">
                    <button type="button" class="notebook-btn-cancel" data-bs-dismiss="modal">Отмена</button>
                    <button type="submit" class="notebook-btn-save">Создать</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Модальное окно РЕДАКТИРОВАНИЯ записи -->
<div class="modal fade" id="editModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content notebook-modal-content">
            <div class="modal-header notebook-modal-header">
                <h5 class="modal-title font-weight-bold">Редактировать жалобу</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="editComplaintId" />
                <input type="hidden" id="status" />

                <div class="mb-3">
                    <label class="form-label text-dark small font-weight-bold">Заголовок</label>
                    <input type="text" id="editTitle" class="form-control notebook-form-input" required />
                </div>

                <!-- Редактирование услуги -->
                <div class="mb-3">
                    <label class="form-label text-dark small font-weight-bold">Наименование услуги</label>
                    <select id="editUtilityId" class="form-select notebook-form-input" required>
                        <option value="">-- Выберите услугу --</option>
                        @if (Model?.AvailableUtilities != null)
                        {
                            foreach (var utility in Model.AvailableUtilities)
                            {
                                <option value="@utility.Id">@utility.Name</option>
                            }
                        }
                    </select>
                </div>

                <!-- Редактирование дат -->
                <div class="row">
                    <div class="col-6 mb-3">
                        <label class="form-label text-dark small font-weight-bold">Дата подачи</label>
                        <input type="datetime-local" id="editSubmissionDate" class="form-control notebook-form-input" />
                    </div>
                    <div class="col-6 mb-3">
                        <label class="form-label text-dark small font-weight-bold">Дата решения</label>
                        <input type="datetime-local" id="editIssueResolutionDate" class="form-control notebook-form-input" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label text-dark small font-weight-bold">Описание</label>
                    <textarea id="editDescription" class="form-control notebook-form-input" rows="4" required></textarea>
                </div>
            </div>
            <div class="modal-footer notebook-modal-footer">
                <button type="button" class="notebook-btn-cancel" data-bs-dismiss="modal">Отмена</button>
                <button type="button" id="btnSaveEdit" class="notebook-btn-save">Сохранить</button>
            </div>
        </div>
    </div>
</div>

<!-- Модальное окно подтверждения удаления -->
<partial name="_ConfirmModal" />

<!-- Модальное окно для предупреждений и ошибок валидации -->
<partial name="_AlertModal" />

@section Scripts {
    <script>
        // 1. Форматирование даты для вывода в футер карточки (dd.MM.yyyy HH:mm)
        function formatDate(dateStr) {
            if (!dateStr) return '';
            var date = new Date(dateStr);
            if (isNaN(date.getTime())) return dateStr;

            var day = String(date.getDate()).padStart(2, '0');
            var month = String(date.getMonth() + 1).padStart(2, '0');
            var year = date.getFullYear();
            var hours = String(date.getHours()).padStart(2, '0');
            var minutes = String(date.getMinutes()).padStart(2, '0');

            return `${day}.${month}.${year} ${hours}:${minutes}`;
        }

        // 2. Форматирование даты для полей <input type="date"> (YYYY-MM-DD)
        function formatDateTimeForInput(dateStr) {
            if (!dateStr) return '';
            var date = new Date(dateStr);
            if (isNaN(date.getTime())) return '';

            var day = String(date.getDate()).padStart(2, '0');
            var month = String(date.getMonth() + 1).padStart(2, '0');
            var year = date.getFullYear();
            var hours = String(date.getHours()).padStart(2, '0');
            var minutes = String(date.getMinutes()).padStart(2, '0');

            return `${year}-${month}-${day}T${hours}:${minutes}`;
        }

        // 3. Генерация HTML-структуры карточки
        function buildCardHtml(card) {
            var cId = card.id ?? card.Id;
            var cTitle = card.title ?? card.Title;
            var cDesc = card.description ?? card.Description;
            var cUtilityId = card.utilityId ?? card.UtilityId;
            var cUtilityName = card.utilityName ?? card.UtilityName ?? '';
            var cCreatedAt = card.createdAt ?? card.CreatedAt;
            var cSubmissionDate = card.submissionDate ?? card.SubmissionDate;
            var cIssueResolutionDate = card.issueResolutionDate ?? card.IssueResolutionDate;
            var iconClass = card.utilityIcon ?? card.UtilityIcon;
            var cStatus = parseInt(card.status ?? card.Status ?? 0);

            return `
                <div class="mb-3 handle-card notebook-complaint-card p-3 shadow-sm bg-white rounded" 
                    id="complaint-${cId}" 
                    draggable="true" 
                    ondragstart="drag(event)" 
                    data-id="${cId}" 
                    data-status="${cStatus}">

                    <!-- ЗОНА 1: ХЭДЕР (Pixel Perfect выравнивание по верхнему краю) -->
                    <div class="d-flex justify-content-between align-items-start gap-2">
                        <div class="d-flex align-items-start gap-2 flex-grow-1">
                            <i class="bi ${iconClass} fs-5 js-card-icon align-self-start" style="display: block; line-height: 1; height: fit-content; margin: 0; padding: 0;" title="${cUtilityName}"></i>
                            <h6 class="mb-0 notebook-card-title js-card-title font-weight-bold align-self-start" style="line-height: 1; margin: 0; padding: 0;">${cTitle}</h6>
                        </div>
                        <div class="d-flex align-items-start gap-1 btn-group-sm align-self-start" style="height: fit-content;">
                            <button class="btn btn-link p-0 m-0 notebook-card-action-btn btn-edit btn-edit-complaint border-0 text-decoration-none text-muted align-self-start"
                                    data-id="${cId}"
                                    data-utility-id="${cUtilityId}"
                                    data-bs-toggle="modal"
                                    data-bs-target="#editModal"
                                    title="Редактировать"
                                    style="display: block; line-height: 1; height: fit-content;">
                                <i class="bi bi-pencil" style="display: block; line-height: 1;"></i>
                            </button>
                            <button class="btn btn-link p-0 m-0 notebook-card-action-btn btn-delete btn-delete-complaint border-0 text-decoration-none text-muted align-self-start"
                                    data-id="${cId}"
                                    data-utility-name="${cUtilityName}"
                                    title="Удалить"
                                    style="display: block; line-height: 1; height: fit-content;">
                                <i class="bi bi-trash3" style="display: block; line-height: 1;"></i>
                            </button>
                        </div>
                    </div>
                    <hr class="my-2 text-muted opacity-25" />
                    <!-- ЗОНА 2: ЦЕНТР -->
                    <div class="py-1">
                        <p class="notebook-card-text mb-0 js-card-description text-secondary small" style="white-space: pre-line;">${cDesc}</p>
                    </div>
                    <hr class="my-2 text-muted opacity-25" />

                    <!-- ЗОНА 3: ФУТЕР -->
                    <div class="d-flex flex-column gap-1 text-muted card-footer-date" style="font-size: 0.75rem;">
                        <!-- Дата создания -->
                        <div class="d-flex justify-content-start align-items-center">
                            <i class="bi bi-file-earmark-plus me-1 text-secondary"></i>
                            <span class="js-card-created-at">Создано: ${formatDate(cCreatedAt)}</span>
                        </div>

                        <!-- Дата подачи (рендерится только если она есть) -->
                        ${cSubmissionDate ? `
                        <div class="d-flex justify-content-start align-items-center">
                            <i class="bi bi-send me-1 text-primary"></i>
                            <span class="js-card-submission-date">Подано: ${formatDate(cSubmissionDate)}</span>
                        </div>
                        ` : ''}

                        <!-- Дата решения (рендерится только если она есть) -->
                        ${cIssueResolutionDate ? `
                        <div class="d-flex justify-content-start align-items-center">
                            <i class="bi bi-check-lg me-1 text-success"></i>
                            <span class="js-card-resolution-date">Решено: ${formatDate(cIssueResolutionDate)}</span>
                        </div>
                        ` : ''}
                    </div>
                </div>`;
        }

        // 4. Логика перетаскивания (Drag and Drop)
        function allowDrop(ev) {
            ev.preventDefault();
        }

        function drag(ev) {
            ev.dataTransfer.setData("text/plain", ev.target.id);
        }

        function drop(ev) {
            ev.preventDefault();
            var data = ev.dataTransfer.getData("text/plain");
            var card = document.getElementById(data);
            var column = ev.target.closest('.complaint-column');

            if (!column || !card) return;

            // 1. Считываем данные ЧЕРЕЗ .attr() и строго ДО перемещения элемента!
            var complaintId = parseInt($(card).attr('data-id'));
            var newStatus = parseInt($(column).attr('data-status'));

            // 2. Перемещаем карточку в новую колонку
            column.appendChild(card);

            // 3. Обновляем дата-атрибуты статуса на самой карточке и кнопке внутри неё,
            // чтобы при клике на "Редактировать" модалка не открывалась со старым статусом
            $(card).attr('data-status', newStatus);
            $(card).data('status', newStatus);
            $(card).find('.btn-edit-complaint').attr('data-status', newStatus);

            // 4. Отправляем классический AJAX-запрос под ваш текущий C# метод
            $.ajax({
                url: '/ComplaintBoard/UpdateStatus',
                type: 'POST',
                // contentType НЕ ПИШЕМ — jQuery автоматически отправит данные как форму
                data: {
                    id: complaintId,   // Имя свойства должно совпадать с именем аргумента в C# (id)
                    status: newStatus  // Должно совпадать с аргументом в C# (status)
                },
                success: function (response) {
                    if (response.success) {
                        // Если на сервере всё прошло успешно — обновляем счетчики
                        updateCounters();
                    } else {
                        // Если сервер вернул false — откатываемся
                        console.error("Ошибка при сохранении статуса");
                        location.reload();
                    }
                },
                error: function (xhr) {
                    // Если упала ошибка сети или 404/500 от сервера — откатываем страницу
                    console.error("Ошибка сервера при переносе карточки:", xhr.status);
                    location.reload();
                }
            });
        }

        // 5. Автоматический пересчет количества карточек в колонках
        function updateCounters() {
            $('.complaint-column').each(function() {
                $(this).closest('.card').find('.card-header .badge').text($(this).children('.handle-card').length);
            });
        }

        // 6. Обработка всех событий после загрузки страницы
        $(document).ready(function () {

            // ОТПРАВКА ФОРМЫ СОЗДАНИЯ (POST)
            $('#addComplaintForm').submit(function (e) {
                e.preventDefault();
                var form = this;

                var requestData = {
                    Title: $(form).find('input[name="EmptyForm.Title"]').val().trim(),
                    UtilityId: parseInt($(form).find('select[name="EmptyForm.UtilityId"]').val()),
                    SubmissionDate: $(form).find('input[name="EmptyForm.SubmissionDate"]').val() || null,
                    IssueResolutionDate: $(form).find('input[name="EmptyForm.IssueResolutionDate"]').val() || null,
                    Description: $(form).find('textarea[name="EmptyForm.Description"]').val().trim()
                };

                $.ajax({
                    url: '/ComplaintBoard/Create',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(requestData),
                    success: function (response) {
                        if (response.success) {
                            $('#addModal').find('[data-bs-dismiss="modal"]').first().click();
                            form.reset();
                            $('.complaint-column[data-status="0"]').prepend(buildCardHtml(response.data));
                            updateCounters();
                        }
                    }
                });
            });

            // ЗАГРУЗКА ДАННЫХ В МОДАЛЬНОЕ ОКНО РЕДАКТИРОВАНИЯ (GET)
            $(document).on('click', '.btn-edit-complaint', function () {
                //var id = $(this).data('id');
                var id = $(this).attr('data-id');

                $('#editComplaintId').val('');
                $('#status').val('');
                $('#editTitle').val('Загрузка...');
                $('#editUtilityId').val('');
                $('#editSubmissionDate').val('');
                $('#editIssueResolutionDate').val('');
                $('#editDescription').val('Подождите...');

                $.ajax({
                    url: '/ComplaintBoard/Get/' + id,
                    type: 'GET',
                    success: function (data) {
                        var cId = data.id ?? data.Id;
                        var cTitle = data.title ?? data.Title;
                        var cDesc = data.description ?? data.Description;
                        var cUtilityId = data.utilityId ?? data.UtilityId;
                        var cSubDate = data.submissionDate ?? data.SubmissionDate;
                        var cResDate = data.issueResolutionDate ?? data.IssueResolutionDate;
                        var cStatus = parseInt(data.status ?? data.Status ?? 0);

                        $('#editComplaintId').val(cId);
                        $('#editTitle').val(cTitle);
                        $('#editUtilityId').val(cUtilityId);
                        $('#editSubmissionDate').val(formatDateTimeForInput(cSubDate));
                        $('#editIssueResolutionDate').val(formatDateTimeForInput(cResDate));
                        $('#editDescription').val(cDesc);
                        $('#status').val(cStatus);
                    }
                });
            });

            // СОХРАНЕНИЕ ОТРЕДАКТИРОВАННЫХ ДАННЫХ (POST)
            $('#btnSaveEdit').click(function () {
                var id = $('#editComplaintId').val();

                var requestData = {
                    Id: parseInt(id),
                    Title: $('#editTitle').val().trim(),
                    UtilityId: parseInt($('#editUtilityId').val()),
                    SubmissionDate: $('#editSubmissionDate').val() || null,
                    IssueResolutionDate: $('#editIssueResolutionDate').val() || null,
                    Description: $('#editDescription').val().trim(),
                    Status: parseInt($('#status').val())
                };

                $.ajax({
                    url: '/ComplaintBoard/Edit/' + id,
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(requestData),
                    success: function (response) {
                        if (response.success) {
                            // Закрываем модальное окно
                            $('#editModal').find('[data-bs-dismiss="modal"]').first().click();

                            // Достаем данные (парсим возможные варианты регистра букв от бэкенда)
                            var uData = response.data;
                            var uTitle = uData.title ?? uData.Title;
                            var uDesc = uData.description ?? uData.Description;
                            var uUtilityId = parseInt(uData.utilityId ?? uData.UtilityId);
                            var uUtilityName = uData.utilityName ?? uData.UtilityName ?? '';
                            var uUtilityIcon = uData.utilityIcon ?? uData.UtilityIcon;
                            var uCreatedAt = uData.createdAt ?? uData.CreatedAt;
                            var uSubmissionDate = uData.submissionDate ?? uData.SubmissionDate;
                            var uIssueResolutionDate = uData.issueResolutionDate ?? uData.IssueResolutionDate;

                            // Находим карточку в DOM по её ID
                            var $card = $('#complaint-' + id);
                            if ($card.length === 0) return; // Защита: если карточка не найдена

                            // 1. Обновляем текст заголовка и описания
                            $card.find('.js-card-title').text(uTitle);
                            $card.find('.js-card-description').text(uDesc);

                            // 2. ЖЕСТКОЕ ОБНОВЛЕНИЕ АТРИБУТОВ (решает проблему кэша jQuery)
                            // Ищем кнопку по тегу и классу .btn-edit
                            var $editBtn = $card.find('button.btn-edit');
                            $editBtn.attr('data-utility-id', uUtilityId);
                            $editBtn.data('utility-id', uUtilityId);

                            // 3. ПЕРЕРИСОВКА ИКОНКИ В DOM 
                            $card.find('.js-card-icon')
                                 .attr('class', 'bi ' + uUtilityIcon + ' fs-5 js-card-icon')
                                 .attr('title', uUtilityName);

                            // 4. ДИНАМИЧЕСКОЕ ОБНОВЛЕНИЕ БЛОКА ДАТ В ФУТЕРЕ
                            var $footerDates = $card.find('.card-footer-date');
                            if ($footerDates.length > 0) {
                                var htmlDates = `
                                    <div class="d-flex justify-content-start align-items-center">
                                        <i class="bi bi-file-earmark-plus me-1 text-secondary"></i>
                                        <span class="js-card-created-at">Создано: ${formatDate(uCreatedAt)}</span>
                                    </div>
                                `;

                                if (uSubmissionDate) {
                                    htmlDates += `
                                        <div class="d-flex justify-content-start align-items-center mt-1">
                                            <i class="bi bi-send me-1 text-primary"></i>
                                            <span class="js-card-submission-date">Подано: ${formatDate(uSubmissionDate)}</span>
                                        </div>
                                    `;
                                }

                                if (uIssueResolutionDate) {
                                    htmlDates += `
                                        <div class="d-flex justify-content-start align-items-center mt-1">
                                            <i class="bi bi-check-lg me-1 text-success"></i>
                                            <span class="js-card-resolution-date">Решено: ${formatDate(uIssueResolutionDate)}</span>
                                        </div>
                                    `;
                                }

                                // Перерисовываем весь футер с датами на лету
                                $footerDates.html(htmlDates);
                            }
                        }
                    }
                });
            });

            // УДАЛЕНИЕ КАРТОЧКИ (DELETE)
            $(document).on('click', '.btn-delete-complaint', function () {

                var targetText = $(this).attr('data-utility-name');
                var id = $(this).data('id');
                var $card = $('#complaint-' + id);

                showConfirm({
                        title: 'Удаление объекта',
                        message: 'Вы действительно хотите удалить жалобу:',
                        targetText: targetText,
                        btnText: 'Удалить',
                        btnClass: 'notebook-delete-btn-confirm', // Включит коралловую границу
                        iconClass: 'bi-trash3-fill notebook-confirm-icon'
                }, function () {
                    $.ajax({
                        url: '/ComplaintBoard/Delete/' + id,
                        type: 'DELETE',
                        success: function (response) {
                            if (response.success) {
                                $card.fadeOut(300, function() {
                                    $(this).remove();
                                    updateCounters();
                                });
                            }
                        }
                    });
                });
            });
        });
    </script>
}
