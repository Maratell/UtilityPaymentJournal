@using UtilityPaymentJournal.Common.Extensions
@{
    ViewData["Title"] = "Home Page";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-9 col-lg-7">

            <!-- Внешний каркас блокнота (имитация кожаной/картонной подложки) -->
            <div class="desk-notebook-container position-relative">

                <!-- Металлические кольца переплета сверху страницы -->
                <div class="notebook-rings-top d-flex justify-content-around">
                    <div class="notebook-ring"></div>
                    <div class="notebook-ring"></div>
                    <div class="notebook-ring"></div>
                    <div class="notebook-ring"></div>
                    <div class="notebook-ring"></div>
                </div>

                <!-- Раскрытый чистый лист плотной бумаги -->
                <div class="notebook-sketch-page text-center">

                    <!-- Известный нам винтажный ярлык-штамп -->
                    <div class="notebook-badge-wrapper mb-4">
                        <div class="notebook-badge-icon">
                            <i class="bi-journal-bookmark-fill"></i>
                        </div>
                    </div>

                    @{
                        var firstName = User.GetFirstName();
                        // Если имя есть — пишем с маленькой буквы, если нет — с большой
                        var welcomeText = !string.IsNullOrEmpty(firstName) ? "добро пожаловать!" : "Добро пожаловать!";
                    }

                    <!-- Заголовок -->
                    <h1 class="notebook-title mb-2">
                        @if (!string.IsNullOrEmpty(firstName))
                        {
                            <span>@firstName, </span>
                        }
                        @welcomeText
                    </h1>
                    <div class="notebook-subtitle-line mx-auto mb-4"></div>

                    <!-- Текст-заметка в блокноте -->
                    <p class="notebook-text mx-auto">
                        Ваш персональный цифровой журнал для коммунальных услуг готов к работе. Начните прямо сейчас.
                    </p>
                </div>
            </div>

        </div>
    </div>
</div>

