@model UtilityPaymentJournal.Models.ComplaintBoard.ComplaintBoardViewModel
@using UtilityPaymentJournal.Common.Enumerations
@using UtilityPaymentJournal.Models.ComplaintBoard
@using UtilityPaymentJournal.Models.Utilities

@{
    ViewData["Title"] = "Интерактивный журнал жалоб";
}

@{
    Func<ComplaintViewModel, Microsoft.AspNetCore.Html.IHtmlContent> RenderComplaintCard = @<text>
    @{
        string iconClass = item.UtilityIcon ?? "bi-tools";

        // Заранее готовим ISO UTC строки для передачи во фронтенд [INDEX]
        string utcCreated = item.CreatedAt.ToString("yyyy-MM-ddTHH:mm:ssZ");
        string utcSubmission = item.SubmissionDate?.ToString("yyyy-MM-ddTHH:mm:ssZ") ?? "";
        string utcResolution = item.IssueResolutionDate?.ToString("yyyy-MM-ddTHH:mm:ssZ") ?? "";
    }

        <div class="mb-3 handle-card notebook-complaint-card p-3 shadow-sm bg-white rounded"
             id="complaint-@item.Id"
             draggable="true"
             ondragstart="drag(event)"
             data-id="@item.Id"
             data-status="@((int)item.Status)">

            <!-- ЗОНА 1: ХЭДЕР (Иконка + Title + Кнопки управления) -->
            <div class="d-flex justify-content-between align-items-start gap-2">
                <div class="d-flex align-items-start gap-2 flex-grow-1">
                    <i class="bi @iconClass fs-5 js-card-icon align-self-start" style="display: block; line-height: 1; height: fit-content; margin: 0; padding: 0;" title="@item.UtilityName"></i>
                    <h6 class="mb-0 notebook-card-title js-card-title font-weight-bold align-self-start" style="line-height: 1; margin: 0; padding: 0;">@item.Title</h6>
                </div>

                <div class="d-flex align-items-start gap-1 btn-group-sm align-self-start" style="height: fit-content;">
                    <!-- Прокидываем СЫРЫЕ UTC-даты в data-атрибуты кнопки, чтобы при первом клике на карандаш
                         (до AJAX обновления) модалка могла корректно прочитать и заполнить инпуты дат -->
                    <button class="btn btn-link p-0 m-0 notebook-card-action-btn btn-edit btn-edit-complaint border-0 text-decoration-none text-muted align-self-start"
                            data-id="@item.Id"
                            data-utility-id="@item.UtilityId"
                            data-submission-date="@utcSubmission"
                            data-issue-resolution-date="@utcResolution"
                            data-bs-toggle="modal"
                            data-bs-target="#editModal"
                            title="Редактировать"
                            style="display: block; line-height: 1; height: fit-content;">
                        <i class="bi bi-pencil" style="display: block; line-height: 1;"></i>
                    </button>
                    <button class="btn btn-link p-0 m-0 notebook-card-action-btn btn-delete btn-delete-complaint border-0 text-decoration-none text-muted align-self-start"
                            data-id="@item.Id"
                            data-utility-name="@item.UtilityName"
                            title="Удалить"
                            style="display: block; line-height: 1; height: fit-content;">
                        <i class="bi bi-trash3" style="display: block; line-height: 1;"></i>
                    </button>
                </div>
            </div>

            <!-- ГОРЗОНТАЛЬНАЯ ЧЕРТА №1 -->
            <hr class="my-2 text-muted opacity-25" />

            <!-- ЗОНА 2: ЦЕНТРАЛЬНАЯ ЧАСТЬ (Description) -->
            <div class="py-1">
                <p class="notebook-card-text mb-0 js-card-description text-secondary small" style="white-space: pre-line;">@item.Description</p>
            </div>

            <!-- ГОРЗОНТАЛЬНАЯ ЧЕРТА №2 -->
            <hr class="my-2 text-muted opacity-25" />

            <!-- ЗОНА 3: ФУТЕР (Даты) -->
            <div class="d-flex flex-column gap-1 text-muted card-footer-date" style="font-size: 0.75rem;">
                <!-- Оборачиваем значение в тег с классом js-localize-date и передаем UTC-строку в атрибут data-utc -->
                <div class="d-flex justify-content-start align-items-center">
                    <i class="bi bi-file-earmark-plus me-1 text-secondary"></i>
                    <span>Создано: <span class="js-localize-date" data-utc="@utcCreated">Загрузка...</span></span>
                </div>

                @if (item.SubmissionDate.HasValue)
                {
                    <div class="d-flex justify-content-start align-items-center">
                        <i class="bi bi-send me-1 text-primary"></i>
                        <span>Подано: <span class="js-localize-date" data-utc="@utcSubmission">Загрузка...</span></span>
                    </div>
                }

                @if (item.IssueResolutionDate.HasValue)
                {
                    <div class="d-flex justify-content-start align-items-center">
                        <i class="bi bi-check-lg me-1 text-success"></i>
                        <span>Решено: <span class="js-localize-date" data-utc="@utcResolution">Загрузка...</span></span>
                    </div>
                }
            </div>

        </div>
    </text>;
}

<div class="container-fluid py-4 kanban-board-bg">

    <!-- Генерируем токен защиты для операций POST, PUT, DELETE на доске жалоб -->
    @Html.AntiForgeryToken()

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="notebook-kanban-title mb-0"></h2>
        <button class="notebook-kanban-add-btn" data-bs-toggle="modal" data-bs-target="#addModal">
            <i class="bi bi-plus-lg me-1"></i> Добавить жалобу
        </button>
    </div>

    <!-- Сетка колонок интерактивной доски -->
    <div class="row">
        <!-- КОЛОНКА: НОВЫЕ -->
        <div class="col-md-4 mb-4">
            <div class="card h-100 notebook-column-card">
                <div class="card-header notebook-column-header header-status-new d-flex justify-content-between align-items-center">
                    <h5 class="m-0">Новые</h5>
                    <span class="badge rounded-pill notebook-column-badge">@(Model?.NewComplaints?.Count ?? 0)</span>
                </div>
                <div class="card-body notebook-column-body complaint-column" style="min-height: 550px;" data-status="@((int)ComplaintStatus.New)" ondragover="allowDrop(event)" ondrop="drop(event)">
                    @if (Model?.NewComplaints != null)
                    {
                        @foreach (var card in Model.NewComplaints)
                        {
                            @RenderComplaintCard(card)
                        }
                    }
                </div>
            </div>
        </div>

        <!-- КОЛОНКА: В РАБОТЕ -->
        <div class="col-md-4 mb-4">
            <div class="card h-100 notebook-column-card">
                <div class="card-header notebook-column-header header-status-progress d-flex justify-content-between align-items-center">
                    <h5 class="m-0">В работе</h5>
                    <span class="badge rounded-pill notebook-column-badge">@(Model?.InProgressComplaints?.Count ?? 0)</span>
                </div>
                <div class="card-body notebook-column-body complaint-column" style="min-height: 550px;" data-status="@((int)ComplaintStatus.InProgress)" ondragover="allowDrop(event)" ondrop="drop(event)">
                    @if (Model?.InProgressComplaints != null)
                    {
                        @foreach (var card in Model.InProgressComplaints)
                        {
                            @RenderComplaintCard(card)
                        }
                    }
                </div>
            </div>
        </div>

        <!-- КОЛОНКА: РЕШЕННЫЕ -->
        <div class="col-md-4 mb-4">
            <div class="card h-100 notebook-column-card">
                <div class="card-header notebook-column-header header-status-resolved d-flex justify-content-between align-items-center">
                    <h5 class="m-0">Решенные</h5>
                    <span class="badge rounded-pill notebook-column-badge">@(Model?.ResolvedComplaints?.Count ?? 0)</span>
                </div>
                <div class="card-body notebook-column-body complaint-column" style="min-height: 550px;" data-status="@((int)ComplaintStatus.Resolved)" ondragover="allowDrop(event)" ondrop="drop(event)">
                    @if (Model?.ResolvedComplaints != null)
                    {
                        @foreach (var card in Model.ResolvedComplaints)
                        {
                            @RenderComplaintCard(card)
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Модальное окно СОЗДАНИЯ записи -->
<div class="modal fade" id="addModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content notebook-modal-content">
            <form id="addComplaintForm">
                <div class="modal-header notebook-modal-header">
                    <h5 class="modal-title font-weight-bold">Новая жалоба</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label text-dark small font-weight-bold">Заголовок</label>
                        <input name="title" class="form-control notebook-form-input" placeholder="Кратко назовите проблему" required />
                    </div>

                    <!-- Выбор услуги из общего справочника -->
                    <div class="mb-3">
                        <label class="form-label text-dark small font-weight-bold">Наименование услуги</label>
                        <select name="utilityId" class="form-select notebook-form-input" required>
                            <option value="">-- Выберите услугу --</option>
                            @foreach (UtilityViewModel utility in Model.AvailableUtilities)
                            {
                                <option value="@utility.Id">@utility.Name</option>
                            }
                        </select>
                    </div>

                    <!-- Поля выбора дат с защитой от ввода некорректного года -->
                    <div class="row">
                        <div class="col-6 mb-3">
                            <label class="form-label text-dark small font-weight-bold">Дата подачи</label>
                            <input type="datetime-local" name="submissionDate" max="2100-12-31T23:59" class="form-control notebook-form-input" />
                        </div>
                        <div class="col-6 mb-3">
                            <label class="form-label text-dark small font-weight-bold">Дата решения</label>
                            <input type="datetime-local" name="issueResolutionDate" max="2100-12-31T23:59" class="form-control notebook-form-input" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-dark small font-weight-bold">Описание</label>
                        <textarea name="description" class="form-control notebook-form-input" rows="4" placeholder="Введите детали..." required></textarea>
                    </div>
                </div>
                <div class="modal-footer notebook-modal-footer">
                    <button type="button" class="notebook-btn-cancel" data-bs-dismiss="modal">Отмена</button>
                    <button type="submit" class="notebook-btn-save">Создать</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Модальное окно РЕДАКТИРОВАНИЯ записи -->
<div class="modal fade" id="editModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content notebook-modal-content">
            <form id="editComplaintForm" autocomplete="off">
                <div class="modal-header notebook-modal-header">
                    <h5 class="modal-title font-weight-bold">Редактировать жалобу</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <!-- Скрытые поля для идентификатора и текущего статуса жалобы -->
                    <input type="hidden" id="editComplaintId" name="id" />
                    <input type="hidden" id="status" name="status" />

                    <div class="mb-3">
                        <label class="form-label text-dark small font-weight-bold">Заголовок</label>
                        <input type="text" id="editTitle" name="title" class="form-control notebook-form-input" required />
                    </div>

                    <!-- Редактирование услуги -->
                    <div class="mb-3">
                        <label class="form-label text-dark small font-weight-bold">Наименование услуги</label>
                        <select id="editUtilityId" name="utilityId" class="form-select notebook-form-input" required>
                            <option value="">-- Выберите услугу --</option>
                            @foreach (UtilityViewModel utility in Model.AvailableUtilities)
                            {
                                <option value="@utility.Id">@utility.Name</option>
                            }
                        </select>
                    </div>

                    <!-- Редактирование дат с защитой от переполнения года -->
                    <div class="row">
                        <div class="col-6 mb-3">
                            <label class="form-label text-dark small font-weight-bold">Дата подачи</label>
                            <input type="datetime-local" id="editSubmissionDate" name="submissionDate" max="2100-12-31T23:59" class="form-control notebook-form-input" />
                        </div>
                        <div class="col-6 mb-3">
                            <label class="form-label text-dark small font-weight-bold">Дата решения</label>
                            <input type="datetime-local" id="editIssueResolutionDate" name="issueResolutionDate" max="2100-12-31T23:59" class="form-control notebook-form-input" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-dark small font-weight-bold">Описание</label>
                        <textarea id="editDescription" name="description" class="form-control notebook-form-input" rows="4" required></textarea>
                    </div>
                </div>
                <div class="modal-footer notebook-modal-footer">
                    <button type="button" class="notebook-btn-cancel" data-bs-dismiss="modal">Отмена</button>
                    <button type="submit" id="btnSaveEdit" class="notebook-btn-save">Сохранить</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Модальное окно подтверждения удаления -->
<partial name="_ConfirmModal" />

<!-- Модальное окно для предупреждений и ошибок валидации -->
<partial name="_AlertModal" />

@section Scripts {
    <script>

        // Генерация HTML-структуры карточки
        function buildCardHtml(card) {
            // Безопасное извлечение свойств (поддерживает и camelCase от API, и PascalCase)
            const cId = card.id ?? card.Id;
            const cTitle = card.title ?? card.Title;
            const cDesc = card.description ?? card.Description;
            const cUtilityId = card.utilityId ?? card.UtilityId;
            const cUtilityName = card.utilityName ?? card.UtilityName ?? '';
            const cCreatedAt = card.createdAt ?? card.CreatedAt;
            const iconClass = card.utilityIcon ?? card.UtilityIcon ?? 'bi-tools';
            const cStatus = parseInt(card.status ?? card.Status ?? 0);

            // Проверяем даты на реальное наличие (исключаем null, undefined и пустые строки)
            const cSubmissionDate = card.submissionDate ?? card.SubmissionDate;
            const hasSubmissionDate = cSubmissionDate && cSubmissionDate !== null && cSubmissionDate !== '';

            const cIssueResolutionDate = card.issueResolutionDate ?? card.IssueResolutionDate;
            const hasResolutionDate = cIssueResolutionDate && cIssueResolutionDate !== null && cIssueResolutionDate !== '';

            return `
                <div class="mb-3 handle-card notebook-complaint-card p-3 shadow-sm bg-white rounded"
                    id="complaint-${cId}"
                    draggable="true"
                    ondragstart="drag(event)"
                    data-id="${cId}"
                    data-status="${cStatus}">

                    <!-- ЗОНА 1: ХЭДЕР (Pixel Perfect выравнивание по верхнему краю) -->
                    <div class="d-flex justify-content-between align-items-start gap-2">
                        <div class="d-flex align-items-start gap-2 flex-grow-1">
                            <i class="bi ${iconClass} fs-5 js-card-icon align-self-start" style="display: block; line-height: 1; height: fit-content; margin: 0; padding: 0;" title="${cUtilityName}"></i>
                            <h6 class="mb-0 notebook-card-title js-card-title font-weight-bold align-self-start" style="line-height: 1; margin: 0; padding: 0;">${cTitle}</h6>
                        </div>
                        <div class="d-flex align-items-start gap-1 btn-group-sm align-self-start" style="height: fit-content;">
                            <button class="btn btn-link p-0 m-0 notebook-card-action-btn btn-edit btn-edit-complaint border-0 text-decoration-none text-muted align-self-start"
                                    data-id="${cId}"
                                    data-utility-id="${cUtilityId}"
                                    data-submission-date="${cSubmissionDate || ''}"
                                    data-issue-resolution-date="${cIssueResolutionDate || ''}"
                                    data-bs-toggle="modal"
                                    data-bs-target="#editModal"
                                    title="Редактировать"
                                    style="display: block; line-height: 1; height: fit-content;">
                                <i class="bi bi-pencil" style="display: block; line-height: 1;"></i>
                            </button>
                            <button class="btn btn-link p-0 m-0 notebook-card-action-btn btn-delete btn-delete-complaint border-0 text-decoration-none text-muted align-self-start"
                                    data-id="${cId}"
                                    data-utility-name="${cUtilityName}"
                                    title="Удалить"
                                    style="display: block; line-height: 1; height: fit-content;">
                                <i class="bi bi-trash3" style="display: block; line-height: 1;"></i>
                            </button>
                        </div>
                    </div>
                    <hr class="my-2 text-muted opacity-25" />
                    <!-- ЗОНА 2: ЦЕНТР -->
                    <div class="py-1">
                        <p class="notebook-card-text mb-0 js-card-description text-secondary small" style="white-space: pre-line;">${cDesc}</p>
                    </div>
                    <hr class="my-2 text-muted opacity-25" />

                    <!-- ЗОНА 3: ФУТЕР -->
                    <div class="d-flex flex-column gap-1 text-muted card-footer-date" style="font-size: 0.75rem;">
                        <!-- Дата создания -->
                        <div class="d-flex justify-content-start align-items-center">
                            <i class="bi bi-file-earmark-plus me-1 text-secondary"></i>
                            <span class="js-card-created-at">Создано: ${formatToReadableText(cCreatedAt)}</span>
                        </div>

                        <!-- Дата подачи (Исправлено: рендерится строго по флагу) -->
                        ${hasSubmissionDate ? `
                        <div class="d-flex justify-content-start align-items-center">
                            <i class="bi bi-send me-1 text-primary"></i>
                            <span class="js-card-submission-date">Подано: ${formatToReadableText(cSubmissionDate)}</span>
                        </div>
                        ` : ''}

                        <!-- Дата решения (Исправлено: рендерится строго по флагу) -->
                        ${hasResolutionDate ? `
                        <div class="d-flex justify-content-start align-items-center">
                            <i class="bi bi-check-lg me-1 text-success"></i>
                            <span class="js-card-resolution-date">Решено: ${formatToReadableText(cIssueResolutionDate)}</span>
                        </div>
                        ` : ''}
                    </div>
                </div>`;
        }

        // Логика перетаскивания (Drag and Drop)
        function allowDrop(ev) {
            ev.preventDefault();
        }

        function drag(ev) {
            ev.dataTransfer.setData("text/plain", ev.target.id);
        }

        function drop(ev) {
            ev.preventDefault();
            const data = ev.dataTransfer.getData("text/plain");
            const card = document.getElementById(data);
            const column = ev.target.closest('.complaint-column');

            if (!column || !card) return;

            // 1. Извлекаем токен безопасности ГЛОБАЛЬНО со всей страницы (так как общей формы тут нет)
            const csrfToken = $('input[name="__RequestVerificationToken"]').val() || '';

            // 2. Считываем данные через .attr() до перемещения элемента
            const complaintId = parseInt($(card).attr('data-id'));
            const newStatus = parseInt($(column).attr('data-status'));

            // 3. Перемещаем карточку в новую колонку
            column.appendChild(card);

            // 4. Обновляем дата-атрибуты статуса на самой карточке
            $(card).attr('data-status', newStatus);
            $(card).data('status', newStatus);
            $(card).find('.btn-edit-complaint').attr('data-status', newStatus);

            // 5. Отправляем AJAX-запрос на новый REST-эндпоинт
            $.ajax({
                url: `/api/complaints/${complaintId}/status/${newStatus}`,
                type: 'PATCH',
                headers: {
                    // ОБЯЗАТЕЛЬНО передаем токен безопасности в заголовке запроса
                    'RequestVerificationToken': csrfToken
                },
                success: function () {
                    // Так как бэкенд возвращает NoContent(), ответа в response не будет.
                    // Если запрос дошел с кодом 2xx — просто обновляем счетчики на доске
                    updateCounters();
                },
                error: function (xhr) {
                    // Пытаемся распарсить ошибку бэкенда
                    if (!tryShowServerError(xhr)) {
                        showAlert('Не удалось обновить статус жалобы на сервере.');
                    }

                    // Перезагружаем страницу
                    location.reload();
                }
            });
        }

        // 5. Автоматический пересчет количества карточек в колонках
        function updateCounters() {
            $('.complaint-column').each(function() {
                $(this).closest('.card').find('.card-header .badge').text($(this).children('.handle-card').length);
            });
        }

        // 6. Обработка всех событий после загрузки страницы
        $(document).ready(function () {

            // Находим все элементы, которые выплюнул Razor с классом .js-localize-date
            $('.js-localize-date').each(function () {
                const rawUtc = $(this).attr('data-utc'); // Забираем точную UTC строку ("2026-07-12T03:02:07Z")

                if (rawUtc) {
                    // Пропускаем её через нашу готовую и проверенную JS-функцию текстового вывода
                    const localText = formatToReadableText(rawUtc);

                    // Заменяем временный текст "Загрузка..." на идеальное локальное время ("12.07.2026, 06:02") [INDEX]
                    $(this).text(localText);
                }
            });

            // ОТПРАВКА ФОРМЫ СОЗДАНИЯ (POST)
            $('#addComplaintForm').submit(function (e) {
                e.preventDefault();
                const form = this;

                // 1. Извлекаем токен безопасности со всей страницы 
                const csrfToken = $('input[name="__RequestVerificationToken"]').val() || '';

                // 2. Извлекаем данные по новым чистым именам полей (без префиксов EmptyForm.)
                const requestData = {
                    title: $(form).find('input[name="title"]').val().trim(),
                    utilityId: parseInt($(form).find('select[name="utilityId"]').val()),
                    submissionDate: toUtcIsoString($(form).find('input[name="submissionDate"]').val()),
                    issueResolutionDate: toUtcIsoString($(form).find('input[name="issueResolutionDate"]').val()),
                    description: $(form).find('textarea[name="description"]').val().trim()
                };

                $.ajax({
                    url: '/api/complaints',          
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(requestData),
                    headers: {
                        // Передаем токен безопасности в заголовке запроса
                        'RequestVerificationToken': csrfToken
                    },
                    success: function (createdCard) { 
                        // Закрываем модальное окно через Bootstrap API
                        $('#addModal').find('[data-bs-dismiss="modal"]').first().click();

                        // Сбрасываем стандартные поля формы
                        form.reset();
                        // Принудительно сбрасываем выпадающий список в дефолтное состояние
                        $(form).find('select[name="utilityId"]').val('');

                        // Забираем статус прямо из объекта ответа (учитывая возможный регистр)
                        const cardStatus = createdCard.status ?? createdCard.Status;

                        // Ищем колонку по реальному статусу карточки
                        $(`.complaint-column[data-status="${cardStatus}"]`).prepend(buildCardHtml(createdCard));

                        // Обновляем счетчики на доске
                        updateCounters();
                    },
                    error: function (xhr) {
                        // console.error("Ошибка при создании жалобы:", xhr.status);
                        // alert("Не удалось создать жалобу. Проверьте правильность заполнения полей.");

                        // Пытаемся распарсить ошибку бэкенда
                        if (!tryShowServerError(xhr)) {
                            showAlert('Не удалось создать жалобу. Проверьте правильность заполнения полей.');
                        }
                    }
                });
            });

            // ЗАГРУЗКА ДАННЫХ В МОДАЛЬНОЕ ОКНО РЕДАКТИРОВАНИЯ (GET)
            $(document).on('click', '.btn-edit-complaint', function () {
                const id = $(this).attr('data-id');

                // Очищаем форму перед загрузкой новых данных
                $('#editComplaintId').val('');
                $('#status').val('');
                $('#editTitle').val('Загрузка...');
                $('#editUtilityId').val('');
                $('#editSubmissionDate').val('');
                $('#editIssueResolutionDate').val('');
                $('#editDescription').val('Подождите...');

                $.ajax({
                    url: `/api/complaints/${id}`, 
                    type: 'GET',
                    success: function (data) {
                        // Безопасное извлечение свойств (поддерживает любой регистр ответа сервера)
                        const cId = data.id ?? data.Id;
                        const cTitle = data.title ?? data.Title;
                        const cDesc = data.description ?? data.Description;
                        const cUtilityId = data.utilityId ?? data.UtilityId;
                        const cSubDate = data.submissionDate ?? data.SubmissionDate;
                        const cResDate = data.issueResolutionDate ?? data.IssueResolutionDate;
                        const cStatus = parseInt(data.status ?? data.Status ?? 0);

                        // Заполняем поля модального окна
                        $('#editComplaintId').val(cId);
                        $('#editTitle').val(cTitle);
                        $('#editUtilityId').val(cUtilityId);
                        $('#editSubmissionDate').val(formatForDateTimeLocal(cSubDate));
                        $('#editIssueResolutionDate').val(formatForDateTimeLocal(cResDate));
                        $('#editDescription').val(cDesc);
                        $('#status').val(cStatus);
                    },
                    error: function (xhr) {
                        // console.error("Ошибка при получении данных жалобы:", xhr.status);
                        // alert("Не удалось загрузить данные жалобы для редактирования.");

                        // Пытаемся распарсить ошибку бэкенда
                        if (!tryShowServerError(xhr)) {
                            showAlert('Не удалось загрузить данные жалобы для редактирования.');
                        }

                        $('#editModal').modal('hide'); // Закрываем модальное окно в случае сбоя
                    }
                });
            });

            // СОХРАНЕНИЕ ОТРЕДАКТИРОВАННЫХ ДАННЫХ (PUT)
            $('#editComplaintForm').submit(function (e) {
                e.preventDefault();

                const id = $('#editComplaintId').val();

                // Извлекаем токен безопасности ГЛОБАЛЬНО со всей страницы (так как общей формы тут нет)
                const csrfToken = $('input[name="__RequestVerificationToken"]').val() || '';

                const requestData = {
                    title: $('#editTitle').val().trim(),
                    utilityId: parseInt($('#editUtilityId').val()),
                    submissionDate: toUtcIsoString($('#editSubmissionDate').val()),
                    issueResolutionDate: toUtcIsoString($('#editIssueResolutionDate').val()),
                    description: $('#editDescription').val().trim(),
                    status: parseInt($('#status').val())
                };

                $.ajax({
                    url: `/api/complaints/${id}`,   
                    type: 'PUT',                      
                    contentType: 'application/json',
                    data: JSON.stringify(requestData),
                    headers: {
                        // Передаем токен безопасности в заголовке запроса
                        'RequestVerificationToken': csrfToken
                    },
                    success: function (updatedCard) {
                        // Закрываем модальное окно
                        $('#editModal').find('[data-bs-dismiss="modal"]').first().click();

                        // Находим старую карточку в DOM по её ID
                        const $card = $('#complaint-' + id);
                        if ($card.length === 0) 
                        return;

                        // Генерируем новый HTML карточки с помощью функции buildCardHtml
                        // и полностью заменяем старую карточку в DOM на новую!
                        $card.replaceWith(buildCardHtml(updatedCard));
                    },
                    error: function (xhr) {
                        // console.error("Ошибка при сохранении изменений жалобы:", xhr.status);
                        // alert("Не удалось сохранить изменения. Проверьте корректность данных.");

                        // Пытаемся распарсить ошибку бэкенда
                        if (!tryShowServerError(xhr)) {
                            showAlert('Не удалось сохранить изменения. Проверьте корректность данных.');
                        }
                    }
                });
            });

            // УДАЛЕНИЕ КАРТОЧКИ (DELETE)
            $(document).on('click', '.btn-delete-complaint', function () {
                const targetText = $(this).attr('data-utility-name');
                const id = $(this).data('id'); // Используем .data('id') или .attr('data-id')
                const $card = $('#complaint-' + id);

                // Извлекаем токен безопасности ГЛОБАЛЬНО со всей страницы (так как общей формы тут нет).
                // За счет замыкания (Closure) переменная будет доступна внутри callback-функции ниже.
                const csrfToken = $('input[name="__RequestVerificationToken"]').val() || '';

                showConfirm({
                        title: 'Удаление объекта',
                        message: 'Вы действительно хотите удалить жалобу:',
                        targetText: targetText,
                        btnText: 'Удалить',
                        btnClass: 'notebook-delete-btn-confirm', // Включит коралловую границу
                        iconClass: 'bi-trash3-fill notebook-confirm-icon'
                }, function () {
                    $.ajax({
                        url: `/api/complaints/${id}`, 
                        type: 'DELETE',
                        headers: {
                            // Передаем токен безопасности в заголовке запроса
                            'RequestVerificationToken': csrfToken
                        },
                        success: function () {
                            // Исправлено: так как бэкенд возвращает NoContent(), ответа в response не будет.
                            // Успешный HTTP статус 204 от сервера сразу запускает этот блок.
                            $card.fadeOut(300, function() {
                                $(this).remove();
                                updateCounters();
                            });
                        },
                        error: function (xhr) {
                            // console.error("Ошибка сервера при удалении карточки:", xhr.status);
                            // alert("Не удалось удалить жалобу. Возможно, она уже была удалена ранее.");

                            // Пытаемся распарсить ошибку бэкенда
                            if (!tryShowServerError(xhr)) {
                                showAlert('Не удалось удалить жалобу. Возможно, она уже была удалена ранее.');
                            }

                            location.reload(); // Перезагружаем доску для актуализации состояния
                        }
                    });
                });
            });
        });
    </script>
}
