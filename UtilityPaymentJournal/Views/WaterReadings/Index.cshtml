@{
    ViewData["Title"] = "Показания счетчиков воды";
}

<div class="container-fluid px-4 mt-5 mb-5">
    <!-- ГЕНЕРИРУЕМ ТОКЕН ЗАЩИТЫ ДЛЯ ВСЕХ ОПЕРАЦИЙ С ТАБЛИЦЕЙ -->
    @Html.AntiForgeryToken()

    <div class="row">
        <div class="col-12">

            <div class="notebook-container">
                <!-- Конфигурация путей к контроллерам в атрибутах таблицы -->
                <table id="readingsTable"
                       data-ajax-url="/api/water-readings"
                       data-create-url="/api/water-readings"
                       data-edit-url="/api/water-readings/"
                       data-delete-url="/api/water-readings/"
                       data-residences-url="/api/residences"
                       data-utilities-url="/api/utility-providers"
                       class="table table-hover notebook-table mb-0"
                       style="width:100%">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 280px;" class="text-center">Действия</th>
                            <th style="width: 300px;" class="text-wrap">Жилой объект</th>
                            <th style="width: 300px;" class="text-wrap">Поставщик услуг</th>
                            <th style="width: 350px;" class="text-center">Тип воды</th>
                            <th style="width: 160px;">Дата подачи</th> 
                            <th style="width: 160px;">Дата оплаты</th>
                            <th style="width: 170px;" class="text-end">Показание<br>прошлое</th>
                            <th style="width: 170px;" class="text-end">Показание<br>текущее</th>
                            <th style="width: 170px;" class="text-end">Показание<br>итог</th>
                            <th style="width: 170px;" class="text-end">Сумма<br>платежа</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Данные загружаются асинхронно через AJAX -->
                    </tbody>
                    @* <tfoot>
                        <tr id="btnAddRow" class="add-row-row">
                            <td colspan="7" class="p-0 border-0">
                                <!-- МОДИФИКАЦИЯ: Добавлен d-flex и justify-content-start -->
                                <div class="p-2 d-flex justify-content-start">
                                    <!-- МОДИФИКАЦИЯ: Удален класс w-100, кнопка больше не растягивается -->
                                    <button type="button" class="btn-notebook-add py-2 fw-semibold d-flex align-items-center gap-2">
                                        <i class="bi bi-plus-lg add-icon"></i>
                                        <span>Добавить новую запись</span>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    </tfoot> *@
                </table>
            </div>

            <div class="mt-3 d-flex justify-content-start">
                <button id="btnAddRow" type="button" class="btn-notebook-add py-2 fw-semibold d-flex align-items-center gap-2">
                    <i class="bi bi-plus-lg add-icon"></i>
                    <span>Добавить новую запись</span>
                </button>
            </div>

            <!-- Контейнер для отображения ошибок валидации -->
            <div id="validationError" class="text-danger small mt-2 fw-medium" style="display: none;"></div>

        </div>
    </div>
</div>

<!-- Модальное окно подтверждения удаления -->
<partial name="_ConfirmModal" />

<!-- Модальное окно для предупреждений и ошибок валидации -->
<partial name="_AlertModal" />

@section Scripts {
    <script>
        var table;
        var residences = []; // Сюда загрузятся данные из UtilityController
        var utilities = [];  // Сюда загрузятся данные из UtilityProviderController

        $(document).ready(function () {
            var $tableEl = $('#readingsTable');
            var resUrl = $tableEl.data('residences-url');
            var utilUrl = $tableEl.data('utilities-url');

            // 1. Предзагрузка справочников для рендеринга выпадающих списков
            Promise.all([
                $.ajax({ url: resUrl, type: "GET" }),
                $.ajax({ url: utilUrl, type: "GET" })
            ])
            .then(function (results) {
                residences = results[0];
                utilities = results[1];

                // 2. Старт DataTables только после наполнения массивов справочников
                initDataTable();

                // 3. Регистрация триггеров на клики по кнопкам управления
                initActionEvents();
            })
            .catch(function (error) {
                console.error("Ошибка предзагрузки справочников:", error);
                alert("Не удалось загрузить списки объектов или поставщиков.");
            });
        });

        function initDataTable() {
            try {
                var ajaxUrl = $('#readingsTable').data('ajax-url');

                table = new window.DataTable('#readingsTable', {
                    "processing": true,
                    "serverSide": false,
                    "autoWidth": false,
                    "scrollX": true, // Включает горизонтальный скролл
                    "ajax": {
                        "url": ajaxUrl,
                        "type": "GET",
                        "dataSrc": ""
                    },
                    "columnDefs": [
                        {
                            "targets": 0, // 2. ВАЖНО: Указываем на самую первую колонку (Действия)
                            "width": "280px", // Задаем жесткую ширину, которую DataTables не сможет уменьшить
                            "orderable": false
                        }
                    ],
                    "columns": [
                        {
                            // 1. Кнопки управления (слева)
                            "data": null,
                            "defaultContent": "",
                            "orderable": false,
                            "className": "text-center align-middle",
                            "render": function (data, type, row) {
                                // Проверяем, является ли строка абсолютно новой (id равен 0 или отсутствует)
                                var isNewRow = (!row.id || row.id === 0);

                                // Если строка новая: view-mode СКРЫВАЕМ (d-none), edit-mode ПОКАЗЫВАЕМ (d-flex)
                                // Если строка старая: view-mode ПОКАЗЫВАЕМ (d-flex), edit-mode СКРЫВАЕМ (d-none)
                                var viewModeClass = isNewRow ? "d-none" : "d-flex";
                                var editModeClass = isNewRow ? "d-flex" : "d-none";

                                return `
                                    <!-- Режим просмотра (для старых записей) -->
                                    <div class="view-mode w-100 ${viewModeClass} justify-content-between align-items-center text-start">
                                        <div class="flex-grow-1 d-flex justify-content-center gap-2">
                                            <button class="btn notebook-btn-action-edit btn-edit-trigger flex-shrink-0 text-nowrap">
                                                <i class="bi bi-pencil-square me-1"></i> Редактировать
                                            </button>
                                            <button class="btn notebook-btn-action-delete btn-delete flex-shrink-0 text-nowrap">
                                                <i class="bi bi-trash3 me-1"></i> Удалить
                                            </button>
                                        </div>
                                    </div>

                                    <!-- Режим редактирования/создания -->
                                    <div class="edit-mode w-100 ${editModeClass} justify-content-center align-items-center">
                                        <div class="d-flex gap-2">
                                            <button class="btn btn-success notebook-btn-action-save flex-shrink-0 text-nowrap">
                                                <i class="bi bi-check-lg me-1"></i> Сохранить
                                            </button>
                                            <button class="btn btn-secondary notebook-btn-action-cancel flex-shrink-0 text-nowrap">
                                                <i class="bi bi-x-lg me-1"></i> Отмена
                                            </button>
                                        </div>
                                    </div>
                                `;
                            }
                        },
                        {
                            // 2. Выпадающий список Жилых объектов
                            "data": "residenceId",
                            "defaultContent": "",
                            "className": "align-middle position-relative",
                            "render": function (data, type, row) {
                                // 1. Находим объект в глобальном массиве residences по его ID, чтобы достать адрес
                                var currentResidence = residences.find(function (item) {
                                    return String(item.id) === String(data);
                                });
                                var addressText = currentResidence ? currentResidence.address : "";

                                // 2. ДЛЯ ПОИСКА И СОРТИРОВКИ:
                                if (type === 'filter' || type === 'sort') {
                                    return addressText;
                                }

                                // 3. РЕЖИМ ПРОСМОТРА (Обычный текст): Гарантирует идеальный перенос строк на экране
                                var viewModeHtml = `<div class="view-mode d-flex text-wrap text-break" style="max-width: 300px; min-width: 150px;">${addressText}</div>`;

                                // 4. РЕЖИМ РЕДАКТИРОВАНИЯ (Выпадающий список): Скрыт по умолчанию через d-none
                                // Добавляем класс w-100 и специальный стиль перевода строк для выпадающего меню
                                var editModeHtml = '<div class="edit-mode d-none w-100">';
                                editModeHtml += '<select class="form-select form-select-sm residence-select w-100" style="white-space: normal; word-break: break-word;">';
                                editModeHtml += '<option value="">-- Выберите объект --</option>';

                                residences.forEach(function (item) {
                                    var isSelected = String(item.id) === String(data) ? 'selected' : '';
                                    editModeHtml += `<option value="${item.id}" ${isSelected}>${item.address}</option>`;
                                });

                                editModeHtml += '</select>';
                                editModeHtml += '</div>';

                                // Возвращаем оба режима в одной ячейке
                                return viewModeHtml + editModeHtml;
                            }
                        },
                        {
                            // 3. Выпадающий список Поставщиков услуг
                            "data": "utilityProviderId",
                            "defaultContent": "",
                            "className": "align-middle position-relative",
                            "render": function (data, type, row) {

                                var currentUtility = utilities.find(function (item) {
                                    return String(item.id) === String(data);
                                });
                                var utilityName = currentUtility ? currentUtility.name : "";

                                // 2. НАСТРОЙКА ПОИСКА И СОРТИРОВКИ:
                                if (type === 'filter' || type === 'sort') {
                                    return utilityName;
                                }

                                // 3. РЕЖИМ ПРОСМОТРА (Обычный текст): Обеспечивает перенос длинных названий компаний
                                var viewModeHtml = `<div class="view-mode d-flex text-wrap text-break" style="max-width: 300px; min-width: 150px;">${utilityName}</div>`;

                                // 4. РЕЖИМ РЕДАКТИРОВАНИЯ (Выпадающий список): Управляется глобальным диспетчером
                                var editModeHtml = '<div class="edit-mode d-none w-100">';
                                editModeHtml += '<select class="form-select form-select-sm utility-select w-100" style="white-space: normal; word-break: break-word;">';
                                editModeHtml += '<option value="">-- Выберите поставщика --</option>';

                                utilities.forEach(function (item) {
                                    var isSelected = String(item.id) === String(data) ? 'selected' : '';
                                    editModeHtml += `<option value="${item.id}" ${isSelected}>${item.name}</option>`;
                                });

                                editModeHtml += '</select>';
                                editModeHtml += '</div>';

                                // Возвращаем оба слоя в ячейку
                                return viewModeHtml + editModeHtml;
                            }
                        },
                        // {
                        //     // 4. Тип воды (Красивый кастомный переключатель БЕЗ шарика)
                        //     "data": "isHotWater",
                        //     "className": "text-center align-middle",
                        //     "render": function (data, type, row, meta) {
                        //         var isChecked = data ? 'checked' : '';
                        //         var uniqueId = 'switch_' + meta.row + '_' + (row.id || 0);

                        //         var initialClass = data ? 'water-style-hot' : 'water-style-cold';
                        //         var initialText = data ? 'Горячая' : 'Холодная';

                        //         return `
                        //             <div class="d-inline-block position-relative">
                        //                 <input class="water-type-switch" type="checkbox" id="${uniqueId}" ${isChecked} disabled>
                        //                 <label class="water-toggle-container ${initialClass}" for="${uniqueId}">
                        //                     <!-- МОДИФИКАЦИЯ: Шарик удален, остался только текст -->
                        //                     <span class="water-toggle-text">${initialText}</span>
                        //                 </label>
                        //             </div>
                        //         `;
                        //     }
                        // },
                        {
                            // 4. Тип воды (Красивый тройной переключатель БЕЗ шарика)
                            "data": "waterType",
                            "className": "text-center align-middle",
                            "defaultContent": 0, // Защита от пустых значений
                            "render": function (data, type, row, meta) {
                                // 1. Для фильтрации и сортировки используем готовый текст с сервера
                                if (type === 'filter' || type === 'sort') {
                                    return row.waterTypeName || row.WaterTypeName || "";
                                }

                                // Safe-check: приводим значение к нижнему регистру для точного сравнения
                                var value = (data !== null && data !== undefined) ? data.toString().toLowerCase() : '0';

                                var uniquePrefix = 'water_' + meta.row + '_' + (row.id || 0);

                                // 2. Проверяем выбранный тип (работает и с числами "0", и со строками "cold")
                                var isCold = (value === '0' || value === 'cold') ? 'checked' : '';
                                var isHot = (value === '1' || value === 'hot') ? 'checked' : '';
                                var isDrain = (value === '2' || value === 'drainage') ? 'checked' : '';

                                // Блокируем переключатель для режима "только чтение"
                                var isDisabled = 'disabled';

                                return `
                                    <div class="triple-water-switch">
                                        <!-- Холодная -->
                                        <input type="radio" name="${uniquePrefix}" id="${uniquePrefix}_0" value="0" ${isCold} ${isDisabled}>
                                        <label for="${uniquePrefix}_0" class="lbl-cold">Холодная</label>

                                        <!-- Горячая -->
                                        <input type="radio" name="${uniquePrefix}" id="${uniquePrefix}_1" value="1" ${isHot} ${isDisabled}>
                                        <label for="${uniquePrefix}_1" class="lbl-hot">Горячая</label>

                                        <!-- Водоотведение -->
                                        <input type="radio" name="${uniquePrefix}" id="${uniquePrefix}_2" value="2" ${isDrain} ${isDisabled}>
                                        <label for="${uniquePrefix}_2" class="lbl-drain">Канализация</label>
                                    </div>
                                `;
                            }
                        },
                        {
                            // 5. Дата подачи
                            "data": "submissionDate",
                            "className": "align-middle",
                            "render": function (data, type, row) {
                                var value = formatDateForInput(data);
                                //return `<input type="date" class="form-control form-control-sm submission-date-input" value="${value}" disabled style="font-size: inherit; font-weight: inherit;">`;

                                // 1. НАСТРОЙКА ФИЛЬТРАЦИИ И ПОИСКА:
                                if (type === 'filter') {
                                    if (!value) return "";

                                    // Превращаем "2026-06-02" в локальный формат "02.06.2026"
                                    var parts = value.split('-');
                                    var localDate = (parts.length === 3) ? `${parts[2]}.${parts[1]}.${parts[0]}` : "";

                                    // Возвращаем оба формата через пробел, чтобы работал поиск по любому из них!
                                    return `${value} ${localDate}`;
                                }

                                // 2. НАСТРОЙКА СОРТИРОВКИ:
                                // Для правильной сортировки дат от старых к новым всегда возвращаем ISO-формат
                                if (type === 'sort') {
                                    return value || "";
                                }

                                // 3. ОБЫЧНОЕ ОТОБРАЖЕНИЕ НА ЭКРАНЕ (type === 'display')
                                var isNewRow = (!row.id || row.id === 0);
                                var disabledAttr = isNewRow ? '' : 'disabled';

                                return `<input type="date" class="form-control form-control-sm submission-date-input" value="${value}" ${disabledAttr} style="font-size: inherit; font-weight: inherit;">`;
                            }
                        },
                        {
                            // 6.  Дата оплаты
                            "data": "paymentDate",
                            "className": "align-middle",
                            "render": function (data, type, row) {
                                var value = formatDateForInput(data);
                                //return `<input type="date" class="form-control form-control-sm payment-date-input" value="${value}" disabled style="font-size: inherit; font-weight: inherit;">`;

                                // 1. НАСТРОЙКА ФИЛЬТРАЦИИ И ПОИСКА:
                                if (type === 'filter') {
                                    if (!value) return "";

                                    // Превращаем "2026-06-02" в локальный формат "02.06.2026"
                                    var parts = value.split('-');
                                    var localDate = (parts.length === 3) ? `${parts[2]}.${parts[1]}.${parts[0]}` : "";

                                    // Возвращаем оба формата через пробел, чтобы работал поиск по любому из них!
                                    return `${value} ${localDate}`;
                                }

                                // 2. НАСТРОЙКА СОРТИРОВКИ:
                                // Для правильной сортировки дат от старых к новым всегда возвращаем ISO-формат
                                if (type === 'sort') {
                                    return value || "";
                                }

                                // 3. ОБЫЧНОЕ ОТОБРАЖЕНИЕ НА ЭКРАНЕ (type === 'display')
                                var isNewRow = (!row.id || row.id === 0);
                                var disabledAttr = isNewRow ? '' : 'disabled';

                                return `<input type="date" class="form-control form-control-sm payment-date-input" value="${value}" ${disabledAttr} style="font-size: inherit; font-weight: inherit;">`;
                            }
                        },
                        {
                            // 7. Текстовое поле ввода показаний за прошлый период
                            "data": "previousValue",
                            "defaultContent": "0",
                            "className": "text-end align-middle",
                            "render": function (data, type, row) {
                                var formatted = data ? parseInt(data, 10) : "0";
                                return `<span class="content-editable-box previous-value-box">${formatted}</span>`;
                            }
                        },
                        {
                            // 8. Текстовое поле ввода текущих показаний
                            "data": "currentValue",
                            "defaultContent": "0",
                            "className": "text-end align-middle",
                            "render": function (data, type, row) {
                                var formatted = data ? parseInt(data, 10) : "0";
                                return `<span class="content-editable-box current-value-box">${formatted}</span>`;
                            }
                        },
                        {
                            // 9. Текстовое поле ввода показаний (результат)
                            "data": "resultValue",
                            "defaultContent": "0",
                            "className": "text-end align-middle",
                            "render": function (data, type, row) {
                                var formatted = data ? parseInt(data, 10) : "0";
                                return `<span class="content-editable-box result-value-box">${formatted}</span>`;
                            }
                        },
                        {
                            // 10. Текстовое поле ввода суммы платежа
                            "data": "paymentAmount",
                            "defaultContent": "0.00",
                            "className": "text-end align-middle",
                            "render": function (data, type, row) {
                                // Преобразуем в число с плавающей точкой, если пусто — выводим 0
                                var num = data ? parseFloat(data) : 0;
                                // Форматируем строго с двумя знаками после запятой (копейки)
                                var formatted = num.toFixed(2);

                                return `<span class="content-editable-box payment-amount-box">${formatted}</span>`;
                            }
                        }
                    ],
                    "createdRow": function (row, data, dataIndex) {
                        // Проверяем, является ли строка действительно новой/пустой
                        if (data.id === undefined || data.id === null || data.id === 0) {
                            var $row = $(row);

                            // 1. Добавляем маркерные классы
                            $row.addClass('row-edit-mode row-new-item');

                            // 2. Единый триггер: сам включит contenteditable и САМ разблокирует все select/input!
                            $row.trigger('editModeChanged', [true]);

                            // Разблокируем элементы формы
                            //$row.find('select').prop('disabled', false);
                            //$row.find('.content-editable-box').attr('contenteditable', 'true');

                            // 3. Переключение видимости кнопок
                            $row.find('.view-mode').removeClass('d-flex').addClass('d-none');
                            $row.find('.edit-mode').removeClass('d-none').addClass('d-flex');
                        }
                    },
                    "language": {
                        "processing": "Загрузка данных...",
                        "search": "Поиск:",
                        "lengthMenu": "Показать _MENU_",
                        "zeroRecords": "Записи не найдены",
                        "emptyTable": "Таблица пуста",
                        "paginate": { "previous": "Пред.", "next": "След." }
                    }
                });

            } catch (error) {
                console.error("Критический сбой инициализации DataTable:", error);
            }
        }

        function initActionEvents() {
            var $tableBody = $('#readingsTable tbody');

            // Кнопка: "➕ Добавить новую запись" в tfoot
            $('#btnAddRow').off('click').click(function (e) {
                e.preventDefault();
                if (!table) return;

                var nowDate = new Date().toISOString().split('T')[0]; // Сегодняшняя дата

                var newRowData = {
                    id: 0,
                    residenceId: "",
                    utilityProviderId: "",
                    waterType: 0,
                    submissionDate: nowDate,
                    paymentDate: null,
                    previousValue:0,
                    currentValue: 0,
                    resultValue: 0,
                    paymentAmount: 0.00
                };

                // 1. Добавляем строку и СРАЗУ получаем ссылку на созданный объект строки DataTables
                var addedRow = table.row.add(newRowData);

                // 2. Однократное событие ожидания отрисовки (draw)
                table.one('draw', function () {
                    // Теперь мы гарантированно берем узел ИМЕННО ТОЙ строки, которую только что создали,
                    // независимо от того, сколько еще строк с id: 0 уже есть в таблице.
                    var rowNode = addedRow.node();

                    if (rowNode) {
                        var $row = $(rowNode);

                        // 1. Активируем маркерные классы режима инлайн-ввода
                        $row.addClass('row-edit-mode row-new-item');

                        // 2. Единый триггер: сам включит contenteditable и разблокирует все select, radio и input!
                        $row.trigger('editModeChanged', [true]);

                        // 3. Фокусируемся на первом селекте
                        setTimeout(function() {
                            $row.find('.residence-select').focus();
                        }, 50);
                    }
                });

                // 3. Вызываем обновленную функцию: она сбросит фильтр поиска и уведет в конец
                redrawAfterChange(table);
            });

            // Кнопка: "Редактировать"
            $tableBody.on('click', '.btn-edit-trigger', function () {
                var $row = $(this).closest('tr');

                // 1. Активируем маркерный класс режима редактирования
                $row.addClass('row-edit-mode');

                // 2. Единый триггер: сам включит contenteditable и разблокирует все селекты и инпуты
                $row.trigger('editModeChanged', [true]);

                // 3. Переключаем видимость интерфейса через стандартные классы Bootstrap
                $row.find('.view-mode').attr('style', 'display: none !important;');
                $row.find('.edit-mode').attr('style', 'display: flex !important;');
            });

            // Кнопка: "Отмена"
            $tableBody.on('click', '.notebook-btn-action-cancel', function () {
                var $row = $(this).closest('tr');

                // Передаем DOM-элемент [0], чтобы DataTables точно определил нужный внутренний индекс строки
                var row = table.row($row[0]);
                var rowData = row.data();

                if (!rowData) return;

                // Проверяем, это отмена создания НОВОЙ строки или редактирования СТАРОЙ
                if (rowData.id === 0 || rowData.id === undefined || rowData.id === null) {
                    // Если строка новая, удаляем её из памяти таблицы
                    row.remove();

                    // Пересчитываем всю сетку пагинации и уводим куда нужно
                    redrawAfterChange(table);
                } else {
                    // Если редактировали старую строку:

                    // 1. Возвращаем исходное состояние данных из кэша памяти и перерисовываем строку.
                    // Метод .draw(false) сам вернет HTML-структуру из вашего 'render' в первоначальный вид.
                    row.data(rowData).invalidate().draw(false);

                    // 2. Так как строка перерисована заново, старый $row больше не валиден в DOM.
                    // Берем свежую ссылку на обновленный узел строки:
                    var rowNode = row.node();
                    if (rowNode) {
                        var $updatedRow = $(rowNode);

                        // Сбрасываем маркерные классы редактирования
                        $updatedRow.removeClass('row-edit-mode row-new-item');

                        // Вызываем триггер переключения режима в false (чтобы заблокировать поля, если это требуется вашей логике)
                        $updatedRow.trigger('editModeChanged', [false]);

                        // Синхронизируем отображение в соответствии с тем, как вы это сделали в кнопке "Редактировать"
                        $updatedRow.find('.edit-mode').attr('style', 'display: none !important;');
                        $updatedRow.find('.view-mode').attr('style', 'display: flex !important;');
                    }
                }

                // Скрываем блок ошибок, если он был открыт
                $('#validationError').hide();
            });

