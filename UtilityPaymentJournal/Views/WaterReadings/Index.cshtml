            // Кнопка: "Сохранить"
            $tableBody.on('click', '.notebook-btn-action-save', function () {
                var $row = $(this).closest('tr');
                var row = table.row($row);
                var rowData = row.data();
                var $errBlock = $('#validationError');

                // Извлекаем токен безопасности ГЛОБАЛЬНО со всей страницы (так как формы тут нет).
                // Делаем это в самом начале клика, чтобы зафиксировать его через замыкание (Closure)
                var csrfToken = $('input[name="__RequestVerificationToken"]').val() || '';

                // Извлекаем жилой объект и поставщика услуг
                var selectedResidence = $row.find('.residence-select').val();
                var selectedUtility = $row.find('.utility-select').val();

                // Извлекаем тип воды
                var selectedWaterType = $row.find('.triple-water-switch input[type="radio"]:checked').val();
                var waterTypeInt = parseInt(selectedWaterType, 10);
                if (isNaN(waterTypeInt)) {
                    waterTypeInt = 0; // На случай непредвиденных сбоев ставим Холодную по умолчанию
                }

                // Извлекаем показания счетчиков
                var currentRaw = $row.find('.current-value-box').text().replace(',', '.').trim();
                var previousRaw = $row.find('.previous-value-box').text().replace(',', '.').trim();
                var resultRaw = $row.find('.result-value-box').text().replace(',', '.').trim();

                // Извлекаем сумму платежа
                var paymentAmountRaw = $row.find('.payment-amount-box').text().replace(',', '.').trim();

                // Извлекаем строго целые числа
                var parsedCurrent = parseInt(currentRaw, 10);
                var parsedPrevious = parseInt(previousRaw, 10);
                var parsedResult = parseInt(resultRaw, 10);
                var parsedPaymentAmount = parseFloat(paymentAmountRaw);

                // Извлекаем даты подачи показаний и платежа
                var submissionDateSelected = $row.find('.submission-date-input').val();
                var paymentDateSelected = $row.find('.payment-date-input').val() || null;

                var currentId = 0;
                if (rowData) {
                    currentId = rowData.id !== undefined ? rowData.id : (rowData.Id !== undefined ? rowData.Id : 0);
                }

                // Валидация жилого объекта и поставщика услуг
                if (!selectedResidence) { showAlert("Выберите жилой объект."); return; }
                if (!selectedUtility) { showAlert("Выберите поставщика услуг."); return; }

                // Валидация показаний счетчика
                if (isNaN(parsedCurrent) || parsedCurrent < 0) { showAlert("Введите корректное текущее показание (значение должно быть положительным)."); return; }
                if (isNaN(parsedPrevious) || parsedPrevious < 0) { showAlert("Введите корректное показание за прошлый период (значение должно быть положительным)."); return; }
                if (isNaN(parsedResult) || parsedResult < 0) { showAlert("Введите корректное результирующее показание (значение должно быть положительным)."); return; }

                // Валидация суммы платежа
                if (isNaN(parsedPaymentAmount) || parsedPaymentAmount < 0) { showAlert("Введите корректную сумму платежа (значение должно быть положительным)."); return; }

                $errBlock.hide();

                // Формируем плоский объект для отправки на контроллер ASP.NET Core (СТРОГО БЕЗ СВОЙСТВА ID)
                var sendData = {
                    residenceId: selectedResidence,
                    utilityProviderId: selectedUtility,
                    waterType: waterTypeInt,
                    submissionDate: submissionDateSelected,
                    paymentDate: paymentDateSelected,
                    previousValue: parsedPrevious,
                    currentValue: parsedCurrent,
                    resultValue: parsedResult,
                    paymentAmount: parsedPaymentAmount
                };

                var targetUrl;
                var httpMethod;

                if (currentId === 0) {
                    // Создание новой записи
                    targetUrl = $('#readingsTable').data('create-url'); // Получим: /api/water-readings
                    httpMethod = "POST";                                // Метод для создания
                } else {
                    // Редактирование существующей записи
                    targetUrl = $('#readingsTable').data('edit-url') + currentId; // Приклеиваем id в конец пути /api/water-readings/
                    httpMethod = "PUT";                                            // Метод для обновления
                }

                // Блокируем строку на время AJAX-запроса через наш глобальный триггер
                $row.trigger('editModeChanged', [false]).css('opacity', '0.5');

                $.ajax({
                    url: targetUrl,
                    type: httpMethod,
                    contentType: "application/json", // говорим серверу, что шлем JSON
                    data: JSON.stringify(sendData),  // Отправляем чистый JSON без Id
                    headers: {
                        // Передаем токен безопасности в заголовке запроса
                        'RequestVerificationToken': csrfToken
                    },
                    success: function (response) {
                        // Формируем URL для GET-запроса развернутых деталей (QueryResultDto со всеми текстовыми Include)
                        var getDetailsUrl = httpMethod === "POST"
                            ? (targetUrl + '/' + response.id) // Для POST: берем ID из WaterReadingCreatedViewModel ответа
                            : targetUrl;                      // Для PUT: ID уже находится в самом targetUrl (/api/water-readings/123)

                        // Запрашиваем из Query-сервиса развернутую модель с адресом и названием провайдера для UI
                        $.ajax({
                            url: getDetailsUrl,
                            type: "GET",
                            headers: { 'RequestVerificationToken': csrfToken },
                            success: function (fullData) {
                                // Передаем полноценный объект со всеми Include напрямую в DataTables
                                table.row($row).data(fullData).draw(false);

                                // Так как данные перерисовались, находим строку в DOM заново
                                var $updatedRow = $(table.row($row).node());
                                $updatedRow.css('opacity', '1');

                                // Возвращаем интерфейс строки в режим просмотра через классы Bootstrap
                                $updatedRow.find('.edit-mode').removeClass('d-flex').addClass('d-none');
                                $updatedRow.find('.view-mode').removeClass('d-none').addClass('d-flex');

                                // Сбрасываем управляющие классы редактирования
                                $updatedRow.removeClass('row-edit-mode row-new-item');
                            },
                            error: function () {
                                // В случае непредвиденного сбоя при GET-запросе, мягко перезагружаем всю таблицу
                                table.ajax.reload(null, false);
                            }
                        });
                    },
                    error: function (xhr) {
                        // Разблокируем строку, чтобы пользователь мог исправить ошибки и нажать "Сохранить" еще раз
                        $row.trigger('editModeChanged', [true]).css('opacity', '1');

                        // Пытаемся распарсить ошибку бэкенда
                        if (tryShowServerError(xhr)) {
                            return;
                        }

                        // Дефолтное сообщение при сохранении
                        showAlert('Ошибка при сохранении изменений.');
                    }
                });
            });

            // Глобальный диспетчер режимов ввода для таблицы показаний
            $tableBody.on('editModeChanged', 'tr', function(e, isEdit) {
                // Включаем или выключаем возможность писать текст в теги span
                $(this).find('.content-editable-box').attr('contenteditable', isEdit ? 'true' : 'false');

                // Автоматически блокируем или разблокируем все выпадающие списки и кнопки в строке
                // Если isEdit === true, то disabled станет false (элементы разблокируются)
                $(this).find('select, input, button').not('.notebook-btn-action-save, .notebook-btn-action-cancel, .btn-edit-trigger').prop('disabled', !isEdit);
            });

            // // Динамическое изменение внешнего вида переключателя холодной-горячей воды
