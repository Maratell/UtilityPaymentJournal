            // Кнопка: "Удалить"
            $tableBody.on('click', '.notebook-btn-action-delete', function () {
                var $row = $(this).closest('tr');
                var row = table.row($row);
                var rowData = row.data();

                // Формируем финальную строку для окна подтверждения
                var targetText = "Показание водоснабжения";

                // Извлекаем токен безопасности.
                // Делаем это в начале клика, чтобы зафиксировать его через замыкание (Closure)
                var csrfToken = $('input[name="__RequestVerificationToken"]').val() || '';

                // Передаем настройки и логику AJAX прямо внутрь функции
                showConfirm({
                        title: 'Удаление объекта',
                        message: 'Вы действительно хотите удалить запись:',
                        targetText: targetText,
                        btnText: 'Удалить',
                        btnClass: 'notebook-delete-btn-confirm', // Включит коралловую границу
                        iconClass: 'bi-trash3-fill notebook-confirm-icon'
                }, function () {

                    var deleteUrl = $('#readingsTable').data('delete-url');

                    // Извлекаем ID из данных строки (с проверкой регистра на всякий случай)
                    var currentId = rowData.id !== undefined ? rowData.id : (rowData.Id !== undefined ? rowData.Id : 0);

                    // Формируем правильный URL, прибавляя ID к базовому пути
                    var targetDeleteUrl = deleteUrl + currentId; // Получится: /api/water-readings/id

                    // Визуально скрываем строку на время запроса
                    $row.css('opacity', '0.5');

                    $.ajax({
                        url: targetDeleteUrl,
                        type: "DELETE",
                        headers: {
                            // Передаем токен безопасности в заголовке запроса
                            'RequestVerificationToken': csrfToken
                        },
                        success: function () {
                            // Перезагружаем данные с сервера со сбросом пагинации на предыдущую страницу
                            table.ajax.reload(function() {
                                // После успешного обновления данных отправляем юзера в самый конец таблицы
                                redrawAfterChange(table);
                            }, true);
                        },
                        error: function (xhr) {
                            // Возвращаем строке прежнюю видимость в случае ошибки
                            $row.css('opacity', '1');

                            // Пытаемся распарсить ошибку бэкенда
                            if (tryShowServerError(xhr)) {
                                return;
                            }

                            // 3. Дефолтное сообщение для удаления
                            showAlert('Ошибка при удалении объекта.');
                        }
                    });
                });
                


