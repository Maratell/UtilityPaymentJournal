        }

        // Метод перестроения пагинации при добавлении / удалении записи
        function redrawAfterChange(tableInstance) {
            // 1. Полностью сбрасываем глобальный поиск/фильтрацию
            tableInstance.search('');

            // Если у вас используются отдельные инпуты для поиска под каждой колонкой,
            // раскомментируйте строку ниже, чтобы сбросить и их тоже:
            // tableInstance.columns().search('');

            // 2. Встроенный метод 'last' теперь безошибочно переведет на истинную последнюю страницу
            tableInstance.page('last').draw('page');
        }

        // Хелпер для форматирования дат под <input type="date">
        function formatDateForInput(dateString) {
            if (!dateString) return "";
            var date = new Date(dateString);
            if (isNaN(date.getTime())) return "";
            var day = ("0" + date.getDate()).slice(-2);
            var month = ("0" + (date.getMonth() + 1)).slice(-2);
            return date.getFullYear() + "-" + month + "-" + day;
        }
    </script>
