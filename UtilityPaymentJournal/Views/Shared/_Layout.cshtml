<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - UtilityPaymentJournal</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    @* <link rel="stylesheet" href="~/lib/datatables/css/dataTables.bootstrap5.min.css" /> *@
    <link rel="stylesheet" href="~/lib/dt/css/dataTables.bootstrap5.min.css" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/UtilityPaymentJournal.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
</head>
<body class="d-flex flex-column min-vh-100">

    <header class="notebook-header mb-4">
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light p-0">
            <div class="container-fluid notebook-nav">
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between w-100">

                    <!-- Левая часть: Закладки ежедневника -->
                    <ul class="navbar-nav notebook-tabs">
                        <li class="nav-item">
                            <a class="nav-link notebook-tab" asp-area="" asp-controller="Residence" asp-action="GetView">
                                <i class="bi bi-house-door tab-icon"></i><!-- Иконка дома -->
                                <span class="tab-text">Жилые объекты</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link notebook-tab" asp-area="" asp-controller="UtilityProvider" asp-action="GetView">
                                <i class="bi bi-briefcase tab-icon"></i><!-- Иконка портфеля -->
                                <span class="tab-text">Поставщики услуг</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link notebook-tab" asp-area="" asp-controller="WaterReadings" asp-action="GetView">
                                <i class="bi bi-droplet tab-icon"></i><!-- Иконка капля -->
                                <span class="tab-text">Счетчики воды</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link notebook-tab" asp-area="" asp-controller="ElectricityReadings" asp-action="GetView">
                                <i class="bi bi-lightning-charge tab-icon"></i><!-- Иконка молния -->
                                <span class="tab-text">Счетчики электроэнергии</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link notebook-tab" asp-area="" asp-controller="ComplaintBoard" asp-action="GetView">
                                <i class="bi bi-kanban tab-icon"></i><!-- Иконка жалобная книга -->
                                <span class="tab-text">Доска жалоб</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link notebook-tab" asp-area="" asp-controller="Home" asp-action="Privacy">
                                <i class="bi bi-shield-lock tab-icon"></i><!-- Иконка замка -->
                                <span class="tab-text">Privacy</span>
                            </a>
                        </li>
                    </ul>

                    <!-- Правая часть: Имя + Иконка выхода -->
                    <ul class="navbar-nav d-flex flex-row align-items-center ms-auto notebook-user-zone">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item d-flex align-items-center me-3">
                                <i class="bi bi-person-circle notebook-user-icon me-2"></i>
                                <span class="nav-link notebook-user-name p-0">
                                    @{
                                        var firstName = User.FindFirst("FirstName")?.Value;
                                        var lastName = User.FindFirst("LastName")?.Value;

                                        // Соединяем имя и фамилию через пробел, игнорируя null и пустые строки
                                        var fullName = string.Join(" ", new[] { firstName, lastName }.Where(s => !string.IsNullOrEmpty(s)));

                                        var displayName = !string.IsNullOrEmpty(fullName) ? fullName : firstName;
                                    }
                                    @displayName
@*                                  @User.FindFirst("FirstName")?.Value @User.FindFirst("LastName")?.Value *@
                                </span>
                            </li>
                            <li class="nav-item d-flex align-items-center">
                                <span class="notebook-user-divider me-3"></span>
                                <form class="form-inline d-inline" asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" id="logoutButton" class="btn btn-link p-0 border-0 align-middle">
                                        <i class="bi bi-box-arrow-right" style="font-size: 1.1rem;"></i>
                                    </button>
                                </form>
                            </li>
                        }
                    </ul>

                </div>
            </div>
        </nav>
    </header>

