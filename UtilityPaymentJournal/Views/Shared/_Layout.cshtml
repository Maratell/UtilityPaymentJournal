    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="notebook-style-footer mt-auto py-4">
        <partial name="_Footer" />
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @* <script src="~/lib/datatables/jquery.dataTables.min.js"></script>
    <script src="~/lib/datatables/dataTables.bootstrap5.min.js"></script> *@

    <script src="~/lib/dt/js/dataTables.min.js"></script>
    <script src="~/lib/dt/js/dataTables.bootstrap5.min.js"> </script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const currentUrl = window.location.pathname;
            const navLinks = document.querySelectorAll("header .navbar-nav .nav-link");

            navLinks.forEach(link => {
                // Если href ссылки совпадает с текущим путем
                if (link.getAttribute("href") === currentUrl) {
                    link.classList.add("active"); // Добавляем класс активности Bootstrap
                    link.classList.add("fw-bold"); // Дополнительно выделяем жирным
                }
            });
        });
    </script>

    <script>
        document.getElementById('logoutButton').addEventListener('click', function () {
            // Получаем URL действия, если скрипт в .cshtml файле
            const logoutUrl = '@Url.Action("Logout", "Account")';

            // Получаем Anti-Forgery токен (обязательно для POST в ASP.NET Core)
            //const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            fetch(logoutUrl, {
                method: 'POST',
                headers: {
                    // Обязательно указываем, что ожидаем JSON в ответ
                    'Accept': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                    //'Content-Type': 'application/json',
                    // 'RequestVerificationToken': token // Отправляем токен в заголовке
                }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // Перенаправление на страницу, указанную в контроллере
                    window.location.href = data.redirectUrl;
                }
            })
            .catch(error => console.error('Ошибка:', error));
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
