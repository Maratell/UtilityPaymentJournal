@using UtilityPaymentJournal.Features.Utilities.GetList
@model IReadOnlyCollection<GetUtilitiesListResponse.Item>

<select name="utilityId" class="form-select notebook-form-input js-utility-dropdown" required>
    <option value="">-- Выберите услугу --</option>
    @foreach (GetUtilitiesListResponse.Item utility in Model)
    {
        <option value="@utility.Id">@utility.Name</option>
    }
</select>
