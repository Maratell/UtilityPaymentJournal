@{
    ViewData["Title"] = "Жилые объекты";
}

<div class="container mt-5 mb-5">
    <!-- Добавлен mb-5 -->
    <div class="row justify-content-center">
        <div class="col-md-8">

            <form id="residenceForm" class="mb-4">
                @Html.AntiForgeryToken() @* Генерируем уникальный токен безопасности для этой страницы *@

                <div class="input-group notebook-style-group">
                    <input type="text" id="addressInput" class="form-control notebook-style-input" placeholder="Введите адрес жилого объекта..." maxlength="100">
                    <button type="submit" class="btn notebook-style-btn" id="btnAdd">Добавить</button>
                </div>
                <div id="validationError" class="text-danger small mt-2 fw-medium" style="display: none;"></div>
            </form>

            <!-- Контейнер для списка -->
            <ul class="list-group notebook-style-list" id="residenceList">
                <!-- Элементы загружаются асинхронно через jQuery AJAX -->
            </ul>

        </div>
    </div>
</div>

<!-- Модальное окно подтверждения удаления -->
<partial name="_ConfirmModal" />

<!-- Модальное окно для предупреждений и ошибок валидации -->
<partial name="_AlertModal" />

@section Scripts {
    <script>
        const apiUrl = '/api/residences';

        $(document).ready(function () {
            loadResidences();

            // 1. ПОЛУЧЕНИЕ И ОТРИСОВКА СПИСКА
            function loadResidences() {
                $.ajax({
                    url: apiUrl,
                    method: 'GET',
                    dataType: 'json',
                    success: function (data) {
                        $('#residenceList').empty();

                        if (data.length === 0) {
                            // Спокойная матовая заглушка для пустого списка
                            $('#residenceList').append('<li class="list-group-item text-center py-4 notebook-style-empty-item">Список жилых объектов пуст</li>');
                            return;
                        }

                        data.forEach(residence => {
                            // Интеграция кастомных стилей блокнота с сохранением JS-классов управления
                            $('#residenceList').append(`
                                <li class="list-group-item notebook-style-item" data-id="${residence.id}">

                                    <!-- Режим просмотра -->
                                    <div class="view-mode w-100 d-flex justify-content-between align-items-center">
                                        <span class="notebook-item-text text-break me-3 clickable-address" title="Нажмите для редактирования">${residence.address}</span>
                                        <div class="flex-shrink-0 d-flex gap-2">
                                            <button class="btn notebook-btn-action-edit btn-edit-trigger">
                                                <i class="bi bi-pencil-square me-1"></i> Редактировать
                                            </button>
                                            <button class="btn notebook-btn-action-delete btn-delete">
                                                <i class="bi bi-trash3 me-1"></i> Удалить
                                            </button>
                                        </div>
                                    </div>

                                    <!-- Режим редактирования -->
                                    <div class="edit-mode w-100 d-none justify-content-between align-items-center">
                                        <div class="w-100 me-3">
                                            <input type="text" class="form-control notebook-style-edit-input edit-input" value="${residence.address}" maxlength="500">
                                            <div class="text-danger small edit-error mt-2 fw-medium" style="display: none;"></div>
                                        </div>
                                        <div class="flex-shrink-0 d-flex gap-2">
                                            <button class="btn notebook-btn-action-save btn-save">
                                                <i class="bi bi-check-lg me-1"></i> Сохранить
                                            </button>
                                            <button class="btn notebook-btn-action-cancel btn-cancel">Отмена</button>
                                        </div>
                                    </div>

                                </li>
                            `);
                        });
                    },
                    error: function () {
                        showAlert('Не удалось загрузить список жилых объектов.');
                    }
                });
            }

            // 2. ДОБАВЛЕНИЕ ЭЛЕМЕНТА
            //$('#btnAdd').click(function () {
            $('#residenceForm').on('submit', function (e) {
                e.preventDefault(); // Блокируем стандартную перезагрузку страницы браузером
                const addressText = $('#addressInput').val().trim();

                if (!addressText) {
                    showAlert('Поле не может быть пустым!');
                    return;
                }

                // Извлекаем сгенерированный токен безопасности из нашей формы
                const csrfToken = $(this).find('input[name="__RequestVerificationToken"]').val() || '';

                const requestData = {
                    address: addressText
                };

                $.ajax({
                    url: apiUrl,
                    method: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(requestData),
                    headers: {
                        // Передаем токен безопасности в заголовке запроса
                        'RequestVerificationToken': csrfToken
                    },
                    success: function () {
                        $('#addressInput').val('');
                        loadResidences();
                    },
                    error: function (xhr) {

                        // Пытаемся распарсить ошибку бэкенда
                        if (tryShowServerError(xhr)) {
                            return;
                        }

                        // Дефолтное сообщение при добавлении элемента
                        showAlert('Ошибка при добавлении элемента.');
                    }
                });
            });

            // 3. ВКЛЮЧЕНИЕ РЕЖИМА РЕДАКТИРОВАНИЯ
            $('#residenceList').on('click', '.clickable-address, .btn-edit-trigger', function () {
                const li = $(this).closest('li');

                // Скрываем режим просмотра и показываем режим редактирования через классы Bootstrap
                li.find('.view-mode').removeClass('d-flex').addClass('d-none');
                li.find('.edit-mode').removeClass('d-none').addClass('d-flex');

                li.find('.edit-input').focus().select();
            });

            // 4. ОТМЕНА РЕДАКТИРОВАНИЯ
            $('#residenceList').on('click', '.btn-cancel', function () {
                const li = $(this).closest('li');
                const originalText = li.find('.notebook-item-text').text(); // Исправлен класс для получения текста

                li.find('.edit-input').val(originalText);
                li.find('.edit-error').hide().text('');

                // Возвращаем видимость режима просмотра и скрываем форму редактирования
                li.find('.edit-mode').removeClass('d-flex').addClass('d-none');
                li.find('.view-mode').removeClass('d-none').addClass('d-flex');
            });

            // 5. СОХРАНЕНИЕ ИЗМЕНЕНИЙ
            $('#residenceList').on('click', '.btn-save', function () {
                const li = $(this).closest('li');
                const id = li.data('id');
                const newAddress = li.find('.edit-input').val().trim();
                const errorBlock = li.find('.edit-error');

                errorBlock.hide().text('');

                if (!newAddress) {
                    showAlert('Адрес не может быть пустым');
                    return;
                }

                // Извлекаем сгенерированный токен безопасности из нашей основной формы #residenceForm
                const csrfToken = $('#residenceForm').find('input[name="__RequestVerificationToken"]').val() || '';

                const requestData = {
                    address: newAddress
                };

                $.ajax({
                    url: `${apiUrl}/${id}`,
                    method: 'PUT',
                    contentType: 'application/json',
                    data: JSON.stringify(requestData),
                    headers: {
                        // Передаем токен безопасности в заголовке запроса
                        'RequestVerificationToken': csrfToken
                    },
                    success: function (updatedResidence) {
                        li.find('.notebook-item-text').text(updatedResidence.address);

                        // ИСПРАВЛЕНО: Вместо инлайновых стилей переключаем классы Bootstrap
                        li.find('.edit-mode').removeClass('d-flex').addClass('d-none');
                        li.find('.view-mode').removeClass('d-none').addClass('d-flex');
                    },
                    error: function (xhr) {

                        // Пытаемся распарсить ошибку бэкенда
                        if (tryShowServerError(xhr)) {
                            return;
                        }

                        // Дефолтное сообщение для удаления
                        showAlert('Ошибка при сохранении изменений.');
                    }
                });
            });

            // 6. УДАЛЕНИЕ
            let listItemToDelete = null;

            $('#residenceList').on('click', '.btn-delete', function () {
                listItemToDelete = $(this).closest('li');
                const id = listItemToDelete.data('id');
                const address = listItemToDelete.find('.notebook-item-text').text();

                 // Извлекаем сгенерированный токен безопасности из формы #residenceForm.
                // За счет замыкания (Closure) переменная будет доступна внутри callback-функции ниже.
                const csrfToken = $('#residenceForm').find('input[name="__RequestVerificationToken"]').val() || '';

                // Передаем настройки и логику AJAX прямо внутрь функции
                showConfirm({
                        title: 'Удаление объекта',
                        message: 'Вы действительно хотите удалить жилой объект по адресу:',
                        targetText: address,
                        btnText: 'Удалить',
                        btnClass: 'notebook-delete-btn-confirm', // Включит коралловую границу
                        iconClass: 'bi-trash3-fill notebook-confirm-icon'
                }, function () {
                    // Этот код выполнится ТОЛЬКО если пользователь нажмет кнопку "Удалить" в окне
                    $.ajax({
                        url: `${apiUrl}/${id}`,
                        method: 'DELETE',
                        headers: {
                            // 2. ОБЯЗАТЕЛЬНО передаем токен безопасности в заголовке запроса
                            'RequestVerificationToken': csrfToken
                        },
                        success: function () {
                            listItemToDelete.fadeOut(250, function () {
                                $(this).remove();
                                if ($('#residenceList li').length === 0) {
                                    loadResidences();
                                }
                            });
                        },
                        error: function (xhr) {

                            // Пытаемся распарсить ошибку бэкенда
                            if (tryShowServerError(xhr)) {
                                return;
                            }

                            // Дефолтное сообщение для удаления
                            showAlert('Ошибка при удалении объекта.');
                        }
                    });
                });
            });
        });
    </script>
}
