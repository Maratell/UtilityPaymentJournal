@using UtilityPaymentJournal.Models.Authentication
@using UtilityPaymentJournal.Models.ViewModels
@model SignInRequestViewModel
@{
    ViewData["Title"] = "Account";
}

<div>
    <div class="d-flex align-items-center justify-content-center min-vh-50 py-5">
        <form id="loginForm" class="w-100 p-4 p-sm-5 border-0 rounded-4 shadow bg-white" style="max-width: 420px;">
            <!-- Автоматически генерирует input с токеном __RequestVerificationToken -->
            @Html.AntiForgeryToken()
            
            <!-- Заголовок с мягким цветом и уменьшенным весом -->
            <h2 class="text-center fw-semibold text-secondary mb-4">Вход в систему</h2>

            <!-- Поле ввода Логина -->
            <div class="form-floating mb-3">
                <input asp-for="UserName" class="form-control rounded-3 border-light-subtle shadow-sm" id="username" placeholder="Логин" />
                <label asp-for="UserName" class="text-muted"></label>
                <span asp-validation-for="UserName" class="text-danger small mt-1 d-block"></span>
            </div>

            <!-- Поле ввода Пароля -->
            <div class="form-floating mb-4">
                <input asp-for="Password" type="password" class="form-control rounded-3 border-light-subtle shadow-sm" id="password" placeholder="Пароль" />
                <label asp-for="Password" class="text-muted"></label>
                <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
            </div>

            <!-- Кнопка с эффектом глубины и плавным переходом -->
            <button type="submit" class="w-100 btn btn-primary btn-lg py-2 fs-6 fw-medium shadow-sm rounded-3">
                Войти
            </button>
        </form>
    </div>
</div>

<!-- Модальное окно для предупреждений и ошибок валидации -->
<partial name="_AlertModal" />

<script>
    document.getElementById('loginForm').addEventListener('submit', function (e) {
        e.preventDefault();

        // 1. Достаем токен безопасности (антиподделки) из формы
        const tokenElement = document.querySelector('input[name="__RequestVerificationToken"]');
        const csrfToken = tokenElement ? tokenElement.value : '';

        // 2. Формируем чистый JavaScript-объект.
        const requestData = {
            userName: document.getElementById('username').value.trim(),
            password: document.getElementById('password').value
        };

        // 3. Отправляем запрос через привычный вам $.ajax
        $.ajax({
            url: '/api/account/sign-in',
            method: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(requestData),
            headers: {
                // Передаем CSRF-токен в заголовке для прохождения валидации безопасности
                'RequestVerificationToken': csrfToken
            },
            success: function (data) {
                // Если сервер вернул 200 OK, проверяем успешность бизнес-логики
                window.location.href = data.redirectUrl;
            },
            error: function (xhr) {

                // 1. Проверяем, вернул ли сервис кастомную ошибку авторизации (errorMessage)
                if (xhr.responseJSON && xhr.responseJSON.errorMessage) {
                    showAlert(xhr.responseJSON.errorMessage); // Выведет "Неверный логин или пароль" или "Аккаунт заблокирован"
                    return;
                }

                // 2. Если это не кастомная ошибка авторизации, пускаем в ход стандартный глобальный хелпер
                if (tryShowServerError(xhr)) {
                    return;
                }

                // 3.Дефолтное сообщение при сбое сети или сервера
                showAlert('Произошла ошибка при обработке запроса.');
            }
        });
    });
</script>

