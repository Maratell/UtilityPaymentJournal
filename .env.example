# ==============================================================================
# ШАБЛОН НАСТРОЕК ОКРУЖЕНИЯ (ENVIRONMENT TEMPLATE)
# Инструкция: Скопируйте этот файл и переименуйте в .env 
# Команда для терминала: cp .env.example .env (или copy .env.example .env в Windows)
# Подходит как для локального запуска, так и для Docker Compose.
# ==============================================================================

# --- ПОРТЫ ---
APP_PORT=38124
DB_PORT=49532
SEQ_PORT=35341

# --- НАСТРОЙКИ БАЗЫ ДАННЫХ ---
DB_USER=test_user
DB_PASSWORD=test_password
DB_NAME=test_postgresdb

# --- НАСТРОЙКИ NET CORE ---
# URL-адрес для Kestrel внутри Docker-контейнера. 
# Переводит проект в чистый HTTP для стабильного запуска через консоль.
# При запуске из-под IDE (Visual Studio) этот параметр не используется (пустая строка).
ASPNETCORE_URLS=http://+:8080